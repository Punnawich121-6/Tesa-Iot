: trips >= threshold ? '#dc2626' : '#10b981'},\n      agentPill:{marginLeft:'auto', display:'inline-flex', alignItems:'center', padding:'5px 14px', borderRadius:'999px',\n        fontWeight:600, fontSize:'13.5px', color: fz ? this.agentColor(fireAgent) : '#94a3b8',\n        background: fz ? this.agentBg(fireAgent) : '#f6f8fb', border:'1px solid '+(fz ? 'transparent' : '#e6ebf2')},\n\n      rvZones: ((s.assign[sel.id]||[]).filter(z=>b.zones.some(x=>x.id===z))).map(z=>({\n        name:zoneName(z),\n        chip:{padding:'5px 12px', borderRadius:'8px', fontSize:'12.5px', fontWeight:600,\n          background:'#f6f8fb', border:'1px solid #e6ebf2', color:'#48566a'}\n      })),\n      rvNoZones: !((s.assign[sel.id]||[]).filter(z=>b.zones.some(x=>x.id===z)).length),\n      rvMissions: s.events.filter(e=>e.text.indexOf(sel.name) >= 0 || e.tag === 'done').slice(0,6).map(e=>({\n        time:e.time, text:e.text,\n        dot:{width:'7px', height:'7px', borderRadius:'50%', flex:'none',\n          background: e.tag === 'done' ? '#10b981' : e.tag === 'detect' ? '#f59e0b' : '#0ea5e9'}\n      })),\n      rvNoMissions: !s.events.length,\n      recall:()=>this.patchRobot(sel.id, {state:'returning'}),\n      recallStyle:{flex:'1', padding:'11px', borderRadius:'10px', cursor:'pointer', fontFamily:\"'Prompt',sans-serif\",\n        fontSize:'13px', fontWeight:600, border:'1px solid #e2e8f2', background:'#fff', color:'#48566a'},\n      charge:()=>this.patchRobot(sel.id, {state: sel.state === 'charging' ? 'patrol' : 'charging'}),\n      chargeStyle:{flex:'1', padding:'11px', borderRadius:'10px', cursor:'pointer', fontFamily:\"'Prompt',sans-serif\",\n        fontSize:'13px', fontWeight:600,\n        border:'1px solid '+(sel.state==='charging' ? 'rgba(16,185,129,.4)' : '#e2e8f2'),\n        background: sel.state==='charging' ? '#e7f8f0' : '#fff', color: sel.state==='charging' ? '#047857' : '#48566a'},\n      chargeLabel: sel.state === 'charging' ? 'ออกจากแท่นชาร์จ' : 'ส่งกลับแท่นชาร์จ',\n      rvName:sel.name, rvShort:sel.short, rvZone: zoneName(selZone),\n      rvGlow:{position:'absolute', inset:0, pointerEvents:'none', opacity: selBurning ? 1 : 0, transition:'opacity .6s',\n        background:'radial-gradient(circle at 48% 58%,rgba(255,120,30,.32),transparent 55%)', mixBlendMode:'screen',\n        animation: selBurning ? 'pcGlow 1.5s infinite' : 'none'},\n      rvFlame:{position:'absolute', left:'44%', bottom:'22%', width:'11%', height:'22%', display: selBurning ? 'block' : 'none',\n        borderRadius:'50% 50% 50% 50%/60% 60% 40% 40%', background:'radial-gradient(circle at 50% 70%,#ffe27a,#ff6a2b 58%,transparent 74%)',\n        animation:'pcFlick .45s infinite alternate'},\n      rvBox:{position:'absolute', left:'38%', bottom:'17%', width:'24%', height:'32%', border:'1.5px solid #38bdf8',\n        borderRadius:'3px', boxShadow:'0 0 10px rgba(56,189,248,.5)', display: selBurning ? 'block' : 'none'},\n      rvBoxLabel:'fire 0.'+Math.round(vAi*100),\n      lidar: rays.join(' '),\n      telemetry:[\n        {k:'STATE', v:stateLabel[sel.state], style:Object.assign({}, tv, {color:sel.color, fontSize:'15px'})},\n        {k:'BATTERY', v:Math.round(sel.bat)+'%', style:Object.assign({}, tv, {color: sel.bat<25 ? '#dc2626' : '#0e1726'})},\n        {k:'AGENT', v:sel.agent, style:Object.assign({}, tv, {color:this.agentColor(sel.agent)})},\n        {k:'ZONE TEMP', v:selData.temp.toFixed(1)+'°C', style:tv},\n        {k:'SMOKE', v:Math.round(selData.smoke), style:tv},\n        {k:'LINK', v:'-52 dBm', style:tv},\n        {k:'ROBOT ID', v:sel.rosId || '—', style:Object.assign({}, tv, {fontFamily:\"'IBM Plex Mono',monospace\", fontSize:'13px'})},\n        {k:'ROSBRIDGE', v:sel.ip ? sel.ip+':9090' : '—', style:Object.assign({}, tv, {fontFamily:\"'IBM Plex Mono',monospace\", fontSize:'13px'})},\n        {k:'SERIAL', v:sel.serial || '—', style:Object.assign({}, tv, {fontFamily:\"'IBM Plex Mono',monospace\", fontSize:'13px'})}\n      ],\n\n      logFilters: [{id:'all', label:'ทั้งหมด'}, {id:'detect', label:'ตรวจพบ'}, {id:'dispatch', label:'ส่งหุ่นยนต์'}, {id:'spray', label:'ฉีดสารดับ'}, {id:'done', label:'ควบคุมได้'}].map(f=>({\n        label:f.label, onClick:()=>this.setState({logFilter:f.id}),\n        style:{padding:'7px 13px', borderRadius:'9px', cursor:'pointer', fontFamily:\"'Prompt',sans-serif\",\n          fontSize:'12.5px', fontWeight:600, whiteSpace:'nowrap',\n          border:'1px solid '+((s.logFilter||'all')===f.id ? '#0e1726' : '#e2e8f2'),\n          background: (s.logFilter||'all')===f.id ? '#0e1726' : '#fff',\n          color: (s.logFilter||'all')===f.id ? '#fff' : '#48566a'}\n      })),\n      clearLog:()=>this.ask('ล้างบันทึกเหตุการณ์?', 'ประวัติเหตุการณ์ทั้งหมดจะถูกลบและไม่สามารถกู้คืนได้', 'ล้างบันทึก', ()=>this.setState({events:[]})),\n      clearLogStyle:{marginLeft:'auto', display: s.events.length ? 'inline-flex' : 'none', alignItems:'center',\n        gap:'6px', padding:'7px 13px', borderRadius:'9px', cursor:'pointer', whiteSpace:'nowrap', flex:'none',\n        fontFamily:\"'Prompt',sans-serif\", fontSize:'12.5px', fontWeight:600,\n        border:'1px solid #fecaca', background:'#fff', color:'#dc2626'},\n      events: s.events.filter(e=>!s.logFilter || s.logFilter==='all' || e.tag===s.logFilter).map(e=>({time:e.time, zone:zoneName(e.zone), tag:({detect:'ตรวจพบ', dispatch:'ส่งหุ่นยนต์', spray:'ฉีดสารดับ', done:'ควบคุมได้'}[e.tag] || e.tag), text:e.text, tagStyle:tagStyle(e.tag)})),\n      eventCount:s.events.length, noEvents: s.events.length === 0,\n      ourSecs:s.lastSecs, lastZone:s.lastZone,\n      stats:[{v:s.lastSecs, u:'s', l:'last response'}, {v:'95', u:'%', l:'faster'}, {v:'41', u:'ms', l:'inference'}],\n\n      batLowOpts:[10,15,20,25,30].map(v=>({\n        label:v+'%', onClick:()=>this.setState({batLow:v}),\n        style:this.segStyle((s.batLow != null ? s.batLow : 18) === v)})),\n      batFullOpts:[80,90,95,100].map(v=>({\n        label:v+'%', onClick:()=>this.setState({batFull:v}),\n        style:this.segStyle((s.batFull != null ? s.batFull : 95) === v)})),\n      batLowNow:(s.batLow != null ? s.batLow : 18) + '%',\n      batFullNow:(s.batFull != null ? s.batFull : 95) + '%',\n      thrOpts, modeOpts, agentMap, assignRows, bldName:b.name\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>
0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Prompt';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"e1a8d702-e1ec-4605-b7f9-07f92733fb75\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Prompt';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"e74d81be-f23b-46ff-abdb-9892dd29fc65\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\n  *{box-sizing:border-box;margin:0;padding:0}\n  body{background:#e9edf3;-webkit-font-smoothing:antialiased;font-family:'Prompt',system-ui,sans-serif}\n  a{color:#2563eb;text-decoration:none}\n  a:hover{color:#1d4ed8}\n  ::-webkit-scrollbar{width:9px;height:9px}\n  ::-webkit-scrollbar-thumb{background:#c8d1de;border-radius:6px}\n  @keyframes pcPulse{50%{opacity:.35}}\n  @keyframes pcSpin{to{transform:rotate(360deg)}}\n  @keyframes pcFire{0%,100%{box-shadow:0 0 0 3px rgba(239,68,68,.16),0 10px 30px rgba(239,68,68,.24)}50%{box-shadow:0 0 0 7px rgba(239,68,68,.09),0 12px 38px rgba(239,68,68,.34)}}\n  @keyframes pcFlick{to{transform:scaleY(1.2) translateY(-2px);opacity:.85}}\n  @keyframes pcGlow{50%{opacity:.5}}\n  @keyframes pcSweep{to{transform:rotate(360deg)}}\n  @keyframes pcScan{0%,100%{top:14%}50%{top:86%}}\n  @keyframes pcRise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}\n<\u002Fstyle>\n<\u002Fhelmet>\n<div style=\"display:flex;min-height:100vh;background:#e9edf3;font-family:'Prompt',system-ui,sans-serif;color:#0e1726;font-size:14px;line-height:1.5\">\n\n  <aside style=\"position:sticky;top:0;align-self:flex-start;height:100vh;width:246px;flex:none;background:#fbfbfa;border-right:1px solid #e6e9ee;display:flex;flex-direction:column;padding:18px 14px 16px;z-index:60\">\n    <div style=\"display:flex;align-items:center;gap:11px;padding:4px 10px 20px\">\n      <img src=\"a96ce09c-8281-48f8-943b-50d7ed77f2a1\" alt=\"pancabo\" style=\"display:block;width:112px;height:auto\">\n      <div style=\"font-family:'IBM Plex Mono',monospace;font-size:8.5px;line-height:1.4;letter-spacing:1.4px;color:#9aa5b4;border-left:1px solid #e6e9ee;padding-left:11px\">FIRE<br>OPS<br>v2.4<\u002Fdiv>\n    <\u002Fdiv>\n\n    <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1.6px;color:#9aa5b4;font-weight:600;padding:6px 12px 8px\">MONITORING<\u002Fdiv>\n    <div style=\"display:flex;flex-direction:column;gap:3px\">\n      <button sc-camel-on-click=\"{{ goLive }}\" style=\"{{ navLive }}\">\n        <svg width=\"17\" height=\"17\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2.5\"><\u002Frect><path d=\"M3 9h18M9 21V9\"><\u002Fpath><\u002Fsvg>\n        <span>Live Monitor<\u002Fspan>\n        <span style=\"{{ navLiveDot }}\"><\u002Fspan>\n      <\u002Fbutton>\n      <button sc-camel-on-click=\"{{ goRobots }}\" style=\"{{ navRobots }}\">\n        <svg width=\"17\" height=\"17\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"8\" width=\"16\" height=\"12\" rx=\"3\"><\u002Frect><path d=\"M12 4v4M9 14h.01M15 14h.01\"><\u002Fpath><\u002Fsvg>\n        <span>Robot View<\u002Fspan>\n      <\u002Fbutton>\n      <button sc-camel-on-click=\"{{ goLog }}\" style=\"{{ navLog }}\">\n        <svg width=\"17\" height=\"17\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01\"><\u002Fpath><\u002Fsvg>\n        <span>Event Log<\u002Fspan>\n      <\u002Fbutton>\n    <\u002Fdiv>\n\n    <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1.6px;color:#9aa5b4;font-weight:600;padding:20px 12px 8px\">SYSTEM<\u002Fdiv>\n    <div style=\"display:flex;flex-direction:column;gap:3px\">\n      <button sc-camel-on-click=\"{{ goCtrl }}\" style=\"{{ navCtrl }}\">\n        <svg width=\"17\" height=\"17\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6\"><\u002Fpath><\u002Fsvg>\n        <span>Robot Control<\u002Fspan>\n      <\u002Fbutton>\n      <button sc-camel-on-click=\"{{ goMaps }}\" style=\"{{ navMaps }}\">\n        <svg width=\"17\" height=\"17\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 4-6 2v14l6-2 6 2 6-2V4l-6 2z\"><\u002Fpath><path d=\"M9 4v14M15 6v14\"><\u002Fpath><\u002Fsvg>\n        <span>Map Builder<\u002Fspan>\n      <\u002Fbutton>\n      <button sc-camel-on-click=\"{{ goDrill }}\" style=\"{{ navDrill }}\">\n        <svg width=\"17\" height=\"17\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3c1.5 3 4.5 4.2 4.5 8a4.5 4.5 0 0 1-9 0C7.5 8 9 6 12 3z\"><\u002Fpath><path d=\"M12 21v-3\"><\u002Fpath><\u002Fsvg>\n        <span>Drill Mode<\u002Fspan>\n      <\u002Fbutton>\n    <\u002Fdiv>\n\n    <div style=\"margin-top:auto;display:flex;flex-direction:column;gap:8px\">\n      <div style=\"display:flex;align-items:center;gap:9px;padding:11px 12px;border-radius:11px;background:#e7f8f0;border:1px solid rgba(16,185,129,.28)\">\n        <span style=\"width:7px;height:7px;border-radius:50%;background:#10b981;flex:none;box-shadow:0 0 0 3px rgba(16,185,129,.18);animation:pcPulse 2s infinite\"><\u002Fspan>\n        <div>\n          <div style=\"font-size:11.5px;font-weight:600;color:#047857;line-height:1.3\">MQTT broker online<\u002Fdiv>\n          <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;color:#3f9a78\">{{ fleetLine }}<\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;color:#9aa5b4;letter-spacing:.4px;padding:0 4px\">uptime {{ uptime }} · edge inference<\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Faside>\n\n  <div style=\"flex:1;min-width:0;display:flex;flex-direction:column\">\n\n    <header style=\"position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:20px;padding:15px 26px;background:rgba(255,255,255,.86);backdrop-filter:blur(16px);border-bottom:1px solid #dde3ec\">\n      <div style=\"min-width:0\">\n        <div style=\"font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:2px;color:#2563eb;font-weight:600;text-transform:uppercase\">{{ pageEyebrow }}<\u002Fdiv>\n        <div style=\"font-size:20px;font-weight:600;letter-spacing:-.4px;line-height:1.2;margin-top:2px\">{{ pageTitle }}<\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"{{ statusChip }}\">\n        <span style=\"{{ statusDot }}\"><\u002Fspan>{{ statusText }}\n      <\u002Fdiv>\n      <sc-if value=\"{{ hasControl }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"{{ controlChip }}\" sc-camel-on-click=\"{{ disconnect }}\" title=\"คลิกเพื่อตัดการเชื่อมต่อ\">\n          <span style=\"{{ controlDot }}\"><\u002Fspan>Controlling: {{ controlling }}\n        <\u002Fdiv>\n      <\u002Fsc-if>\n      <div style=\"margin-left:auto;display:flex;align-items:center;gap:18px\">\n        <div style=\"text-align:right\">\n          <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1.4px;color:#94a3b8\">LOCAL TIME<\u002Fdiv>\n          <div style=\"font-family:'IBM Plex Mono',monospace;font-size:15px;color:#0e1726;letter-spacing:.6px;font-weight:500\">{{ clock }}<\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"width:1px;height:30px;background:#dde3ec\"><\u002Fdiv>\n        <div style=\"display:flex;align-items:center;gap:9px\">\n          <div style=\"width:32px;height:32px;border-radius:9px;background:#0c1421;color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600\">OP<\u002Fdiv>\n          <div style=\"font-size:12px;line-height:1.25\"><div style=\"font-weight:600\">{{ siteName }}<\u002Fdiv><div style=\"color:#8494a8;font-size:11px\">Operator · shift A<\u002Fdiv><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fheader>\n\n    <sc-if value=\"{{ fireOn }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"display:flex;align-items:center;gap:14px;padding:13px 26px;background:linear-gradient(90deg,#dc2626,#ef4444);color:#fff;animation:pcRise .25s ease\">\n        <span style=\"width:9px;height:9px;border-radius:50%;background:#fff;animation:pcPulse .8s infinite;flex:none\"><\u002Fspan>\n        <div style=\"font-weight:700;font-size:15px;letter-spacing:-.2px\">เหตุไฟไหม้ · {{ fireZoneName }}<\u002Fdiv>\n        <div style=\"font-family:'IBM Plex Mono',monospace;font-size:12px;opacity:.9\">{{ firePhaseLabel }} · T+{{ fireT }}s · agent {{ fireAgent }}<\u002Fdiv>\n        <button sc-camel-on-click=\"{{ reset }}\" style=\"margin-left:auto;padding:7px 15px;border-radius:9px;border:1px solid rgba(255,255,255,.5);background:rgba(255,255,255,.14);color:#fff;font-family:'Prompt',sans-serif;font-size:12.5px;font-weight:600;cursor:pointer\">ยกเลิกสถานการณ์<\u002Fbutton>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n    <main style=\"padding:22px 26px 34px;flex:1\">\n\n      <sc-if value=\"{{ isLive }}\" hint-placeholder-val=\"{{ true }}\">\n      <div data-screen-label=\"Live Monitor\" style=\"display:flex;flex-direction:column;gap:18px;animation:pcRise .3s ease\">\n\n        <div style=\"{{ kpiGrid }}\">\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:15px;padding:16px 18px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1.4px;color:#94a3b8;font-weight:600\">ZONES MONITORED<\u002Fdiv>\n            <div style=\"display:flex;align-items:baseline;gap:8px;margin-top:8px\"><div style=\"font-size:30px;font-weight:700;letter-spacing:-1px;line-height:1\">{{ zoneCount }}<\u002Fdiv><div style=\"font-size:12px;color:#8494a8\">โซนใน {{ bldCount }} อาคาร<\u002Fdiv><\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:15px;padding:16px 18px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1.4px;color:#94a3b8;font-weight:600\">HOTTEST ZONE<\u002Fdiv>\n            <div style=\"display:flex;align-items:baseline;gap:8px;margin-top:8px\"><div style=\"{{ hotVal }}\">{{ hotTemp }}<\u002Fdiv><div style=\"font-size:12px;color:#8494a8\">{{ hotName }}<\u002Fdiv><\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:15px;padding:16px 18px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1.4px;color:#94a3b8;font-weight:600\">FUSION SIGNALS<\u002Fdiv>\n            <div style=\"display:flex;align-items:baseline;gap:8px;margin-top:8px\"><div style=\"{{ fusionVal }}\">{{ fusionCount }}/4<\u002Fdiv><div style=\"font-size:12px;color:#8494a8\">เกณฑ์ ≥ {{ threshold }}<\u002Fdiv><\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:15px;padding:16px 18px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1.4px;color:#94a3b8;font-weight:600\">FLEET READY<\u002Fdiv>\n            <div style=\"display:flex;align-items:baseline;gap:8px;margin-top:8px\"><div style=\"font-size:30px;font-weight:700;letter-spacing:-1px;line-height:1\">{{ readyCount }}<span style=\"font-size:16px;color:#8494a8\">/{{ robotCount }}<\u002Fspan><\u002Fdiv><div style=\"font-size:12px;color:#8494a8\">พร้อมออกปฏิบัติ<\u002Fdiv><\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <div style=\"{{ splitGrid }}\">\n\n          <div style=\"display:flex;flex-direction:column;background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04),0 8px 24px rgba(14,23,38,.04);overflow:hidden\">\n            <div style=\"display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid #eef2f7;min-width:0\">\n              <span style=\"font-size:15px;font-weight:600;letter-spacing:-.2px;white-space:nowrap\">แผนผังอาคาร<\u002Fspan>\n              <sc-raw-select value=\"{{ bld }}\" sc-camel-on-change=\"{{ onBld }}\" style=\"{{ bldSelect }}\">\n                <sc-for list=\"{{ bldOpts }}\" as=\"b\" hint-placeholder-count=\"2\">\n                  <option value=\"{{ b.id }}\">{{ b.label }}<\u002Foption>\n                <\u002Fsc-for>\n              <\u002Fsc-raw-select>\n              <span style=\"{{ mapBadge }}\">{{ mapBadgeText }}<\u002Fspan>\n              <button sc-camel-on-click=\"{{ goMaps }}\" style=\"{{ toMapsBtn }}\" style-hover=\"border-color:#2563eb;color:#2563eb\">แก้ไขที่ Map Builder<\u002Fbutton>\n            <\u002Fdiv>\n\n            <div style=\"padding:16px 18px 18px;flex:1;display:flex;flex-direction:column;min-height:0;gap:11px\">\n              <div ref=\"{{ mapRef }}\" style=\"position:relative;width:100%;flex:1;min-height:340px;border-radius:13px;overflow:hidden;background:#f5f8fb;border:1px solid #e6ebf2;background-image:linear-gradient(#eaeff6 1px,transparent 1px),linear-gradient(90deg,#eaeff6 1px,transparent 1px);background-size:34px 34px\">\n                <div style=\"{{ planStyle }}\"><\u002Fdiv>\n                <svg style=\"{{ wallSvg }}\" sc-camel-preserve-aspect-ratio=\"none\" sc-camel-view-box=\"0 0 100 100\">\n                  <sc-for list=\"{{ walls }}\" as=\"w\" hint-placeholder-count=\"0\">\n                    <line x1=\"{{ w.x1 }}\" y1=\"{{ w.y1 }}\" x2=\"{{ w.x2 }}\" y2=\"{{ w.y2 }}\" vector-effect=\"non-scaling-stroke\" sc-camel-on-click=\"{{ w.onClick }}\" style=\"{{ w.style }}\"><\u002Fline>\n                  <\u002Fsc-for>\n                  <line x1=\"{{ draftWall.x1 }}\" y1=\"{{ draftWall.y1 }}\" x2=\"{{ draftWall.x2 }}\" y2=\"{{ draftWall.y2 }}\" vector-effect=\"non-scaling-stroke\" style=\"{{ draftStyle }}\"><\u002Fline>\n                <\u002Fsvg>\n                <div sc-camel-on-pointer-down=\"{{ onMapDown }}\" style=\"{{ drawLayer }}\"><\u002Fdiv>\n                <sc-for list=\"{{ mapZones }}\" as=\"z\" hint-placeholder-count=\"4\">\n                  <div sc-camel-on-pointer-down=\"{{ z.onDragStart }}\" style=\"{{ z.box }}\">\n                    <button sc-camel-on-pointer-down=\"{{ z.onDelDown }}\" sc-camel-on-click=\"{{ z.onDelete }}\" style=\"{{ z.delStyle }}\">✕<\u002Fbutton>\n                    <div sc-camel-on-pointer-down=\"{{ z.onResizeStart }}\" style=\"{{ z.handleStyle }}\"><\u002Fdiv>\n                    <div style=\"display:flex;align-items:center;gap:7px\">\n                      <div style=\"{{ z.nameStyle }}\">{{ z.name }}<\u002Fdiv>\n                      <div style=\"{{ z.pill }}\">{{ z.status }}<\u002Fdiv>\n                    <\u002Fdiv>\n                    <div style=\"font-size:10.5px;color:#8494a8;margin-top:1px\">{{ z.type }}<\u002Fdiv>\n                    <div style=\"margin-top:auto;display:flex;align-items:center;gap:7px\">\n                      <span style=\"{{ z.tempStyle }}\">{{ z.tempTxt }}<\u002Fspan>\n                      <span style=\"{{ z.ownerChip }}\">{{ z.assigned }}<\u002Fspan>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n                <sc-for list=\"{{ mapRobots }}\" as=\"r\" hint-placeholder-count=\"3\">\n                  <div style=\"{{ r.wrap }}\">\n                    <div style=\"{{ r.scan }}\"><\u002Fdiv>\n                    <div style=\"{{ r.body }}\">{{ r.short }}<\u002Fdiv>\n                    <div style=\"{{ r.lbl }}\">{{ r.state }}<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n              <div style=\"display:flex;align-items:center;gap:16px;flex-wrap:wrap\">\n                <sc-for list=\"{{ legend }}\" as=\"l\" hint-placeholder-count=\"4\">\n                  <div style=\"display:flex;align-items:center;gap:7px\">\n                    <span style=\"{{ l.dot }}\"><\u002Fspan>\n                    <span style=\"font-size:11.5px;color:#8494a8\">{{ l.label }}<\u002Fspan>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n                <span style=\"{{ moreStyle }}\">{{ moreLabel }}<\u002Fspan>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"display:flex;flex-direction:column;gap:16px\">\n\n            <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n              <div style=\"display:flex;align-items:center;gap:9px;padding:15px 18px;border-bottom:1px solid #eef2f7\">\n                <span style=\"font-size:15px;font-weight:600;letter-spacing:-.2px\">ค่าเซ็นเซอร์ · แนวโน้ม<\u002Fspan>\n                <span style=\"margin-left:auto;font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1px;color:#059669;background:#e7f8f0;border:1px solid rgba(16,185,129,.3);padding:4px 9px;border-radius:6px;font-weight:600\">● LIVE 1s<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"display:flex;flex-direction:column;gap:10px;padding:14px\">\n                <sc-for list=\"{{ zoneCards }}\" as=\"z\" hint-placeholder-count=\"4\">\n                  <div style=\"{{ z.card }}\">\n                    <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px\">\n                      <span style=\"{{ z.dot }}\"><\u002Fspan>\n                      <span style=\"font-size:13px;font-weight:600\">{{ z.name }}<\u002Fspan>\n                      <span style=\"font-size:11px;color:#8494a8\">{{ z.type }}<\u002Fspan>\n                      <span style=\"{{ z.pill }}\">{{ z.status }}<\u002Fspan>\n                    <\u002Fdiv>\n                    <div style=\"display:flex;align-items:center;gap:10px\">\n                      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:6px;flex:1\">\n                        <div style=\"{{ z.mTemp }}\"><div style=\"{{ z.vTemp }}\">{{ z.temp }}<\u002Fdiv><div style=\"font-size:8px;color:#94a3b8;letter-spacing:.5px;text-transform:uppercase;margin-top:2px;font-weight:600\">°C<\u002Fdiv><\u002Fdiv>\n                        <div style=\"{{ z.mSmoke }}\"><div style=\"{{ z.vSmoke }}\">{{ z.smoke }}<\u002Fdiv><div style=\"font-size:8px;color:#94a3b8;letter-spacing:.5px;text-transform:uppercase;margin-top:2px;font-weight:600\">smoke<\u002Fdiv><\u002Fdiv>\n                        <div style=\"{{ z.mCo }}\"><div style=\"{{ z.vCo }}\">{{ z.co }}<\u002Fdiv><div style=\"font-size:8px;color:#94a3b8;letter-spacing:.5px;text-transform:uppercase;margin-top:2px;font-weight:600\">CO ppm<\u002Fdiv><\u002Fdiv>\n                      <\u002Fdiv>\n                      <svg width=\"60\" height=\"38\" sc-camel-view-box=\"0 0 58 38\" style=\"flex:none;overflow:visible\">\n                        <polyline points=\"{{ z.spark }}\" fill=\"none\" stroke=\"{{ z.sparkColor }}\" stroke-width=\"1.8\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><\u002Fpolyline>\n                      <\u002Fsvg>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <div style=\"{{ splitGrid }}\">\n\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"display:flex;align-items:center;gap:9px;padding:15px 18px;border-bottom:1px solid #eef2f7\">\n              <span style=\"font-size:15px;font-weight:600;letter-spacing:-.2px\">AI ตรวจจับไฟ + การตัดสินใจบน Edge<\u002Fspan>\n              <span style=\"{{ aiBadge }}\">{{ aiBadgeText }}<\u002Fspan>\n            <\u002Fdiv>\n            <div style=\"{{ aiGrid }}\">\n              <div>\n                <div style=\"display:flex;align-items:center;gap:14px;margin-bottom:16px\">\n                  <div style=\"width:74px;height:56px;border-radius:10px;flex:none;position:relative;overflow:hidden;background:#0b1420;border:1px solid #dde3ec\">\n                    <div style=\"position:absolute;top:4px;left:6px;font-family:'IBM Plex Mono',monospace;font-size:8px;color:rgba(255,255,255,.45);z-index:3\">AI<\u002Fdiv>\n                    <div style=\"{{ camFlame }}\"><\u002Fdiv>\n                    <div style=\"{{ camBox }}\"><\u002Fdiv>\n                    <div style=\"position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(255,255,255,.035) 0 2px,transparent 2px 4px)\"><\u002Fdiv>\n                  <\u002Fdiv>\n                  <div>\n                    <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1.2px;color:#94a3b8;font-weight:600\">VISION MODEL · ON-DEVICE<\u002Fdiv>\n                    <div style=\"{{ verdictStyle }}\">{{ verdict }}<\u002Fdiv>\n                    <div style=\"font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#2563eb\">confidence {{ conf }}<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"display:flex;flex-direction:column;gap:9px\">\n                  <sc-for list=\"{{ votes }}\" as=\"v\" hint-placeholder-count=\"4\">\n                    <div style=\"display:flex;align-items:center;gap:10px\">\n                      <span style=\"width:82px;flex:none;color:#8494a8;font-family:'IBM Plex Mono',monospace;font-size:10.5px\">{{ v.key }}<\u002Fspan>\n                      <div style=\"flex:1;height:8px;border-radius:5px;background:#f1f5f9;overflow:hidden;border:1px solid #e6ebf2\"><i style=\"{{ v.bar }}\"><\u002Fi><\u002Fdiv>\n                      <span style=\"font-family:'IBM Plex Mono',monospace;font-size:11px;width:42px;text-align:right;color:#48566a\">{{ v.val }}<\u002Fspan>\n                    <\u002Fdiv>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"display:flex;flex-direction:column;gap:11px\">\n                <div style=\"{{ fusionBox }}\">\n                  <div style=\"font-size:11.5px;color:#48566a\">Sensor fusion · เกณฑ์ ≥ {{ threshold }} จาก 4 สัญญาณ<\u002Fdiv>\n                  <div style=\"{{ fusionRes }}\">{{ fusionCount }} / 4<\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:12px;background:#f6f8fb;border:1px solid #e6ebf2\">\n                  <span style=\"font-size:11.5px;color:#8494a8\">สารดับที่เลือก<\u002Fspan>\n                  <span style=\"{{ agentPill }}\">{{ fireAgent }}<\u002Fspan>\n                <\u002Fdiv>\n                <div style=\"padding:12px 14px;border-radius:12px;background:#f6f8fb;border:1px solid #e6ebf2\">\n                  <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1.2px;color:#94a3b8;font-weight:600;margin-bottom:8px\">DECISION TRACE<\u002Fdiv>\n                  <div style=\"display:flex;flex-direction:column;gap:7px\">\n                    <sc-for list=\"{{ trace }}\" as=\"t\" hint-placeholder-count=\"3\">\n                      <div style=\"display:flex;align-items:center;gap:9px\">\n                        <span style=\"{{ t.dot }}\"><\u002Fspan>\n                        <span style=\"{{ t.text }}\">{{ t.label }}<\u002Fspan>\n                        <span style=\"margin-left:auto;font-family:'IBM Plex Mono',monospace;font-size:10px;color:#94a3b8\">{{ t.at }}<\u002Fspan>\n                      <\u002Fdiv>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"align-self:start;background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"display:flex;align-items:center;gap:9px;padding:15px 18px;border-bottom:1px solid #eef2f7\">\n              <span style=\"font-size:15px;font-weight:600;letter-spacing:-.2px\">สถานะกองหุ่นยนต์<\u002Fspan>\n              <span style=\"margin-left:auto;font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1px;color:#94a3b8;background:#f6f8fb;padding:4px 9px;border-radius:6px;border:1px solid #e6ebf2\">{{ robotCount }} UNITS<\u002Fspan>\n            <\u002Fdiv>\n            <div style=\"padding:14px;display:flex;flex-direction:column;gap:10px\">\n              <sc-for list=\"{{ fleet }}\" as=\"r\" hint-placeholder-count=\"3\">\n                <div sc-camel-on-click=\"{{ r.onClick }}\" style=\"{{ r.row }}\">\n                  <div style=\"{{ r.badge }}\">{{ r.short }}<\u002Fdiv>\n                  <div style=\"flex:1;min-width:0\">\n                    <div style=\"font-size:13px;font-weight:600\">{{ r.name }}<\u002Fdiv>\n                    <div style=\"font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#8494a8\">{{ r.zoneLabel }} · {{ r.agent }}<\u002Fdiv>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;flex-direction:column;align-items:flex-end;gap:5px\">\n                    <span style=\"{{ r.pill }}\">{{ r.state }}<\u002Fspan>\n                    <div style=\"display:flex;align-items:center;gap:6px\">\n                      <div style=\"width:34px;height:5px;border-radius:3px;background:#e6ebf2;overflow:hidden\"><i style=\"{{ r.batBar }}\"><\u002Fi><\u002Fdiv>\n                      <span style=\"font-family:'IBM Plex Mono',monospace;font-size:10px;color:#8494a8\">{{ r.bat }}%<\u002Fspan>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <sc-if value=\"{{ isRobots }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Robot View\" style=\"{{ robotGrid }}\">\n        <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n          <div style=\"padding:15px 18px;border-bottom:1px solid #eef2f7;font-size:15px;font-weight:600;letter-spacing:-.2px\">เลือกหุ่นยนต์<\u002Fdiv>\n          <div style=\"padding:14px 18px\">\n            <div style=\"{{ pickerRow }}\">\n              <sc-for list=\"{{ fleet }}\" as=\"r\" hint-placeholder-count=\"3\">\n                <div sc-camel-on-click=\"{{ r.onClick }}\" style=\"{{ r.pick }}\">\n                  <div style=\"{{ r.badge }}\">{{ r.short }}<\u002Fdiv>\n                  <div style=\"min-width:0\">\n                    <div style=\"font-size:13px;font-weight:600;white-space:nowrap\">{{ r.name }}<\u002Fdiv>\n                    <div style=\"font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#8494a8;white-space:nowrap\">{{ r.state }} · {{ r.bat }}%<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <div style=\"display:flex;flex-direction:column;gap:16px\">\n          <div style=\"{{ pairGrid }}\">\n            <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04);overflow:hidden\">\n              <div style=\"display:flex;align-items:center;gap:9px;padding:15px 18px;border-bottom:1px solid #eef2f7\">\n                <span style=\"font-size:15px;font-weight:600;letter-spacing:-.2px\">กล้อง + AI detection<\u002Fspan>\n                <span style=\"margin-left:auto;font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1px;color:#059669;background:#e7f8f0;border:1px solid rgba(16,185,129,.3);padding:4px 9px;border-radius:6px;font-weight:600\">● LIVE<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"padding:16px\">\n                <div style=\"position:relative;aspect-ratio:4/3;border-radius:12px;overflow:hidden;background:#0b1420;border:1px solid #dde3ec\">\n                  <div style=\"position:absolute;inset:0;background:radial-gradient(circle at 50% 118%,rgba(56,110,180,.16),transparent 60%),linear-gradient(180deg,#1a2740,#141d2e 55%,#0f1622)\"><\u002Fdiv>\n                  <div style=\"position:absolute;left:7%;top:36%;width:19%;height:46%;background:#1c2942;border:1px solid #33445f;border-radius:2px\"><\u002Fdiv>\n                  <div style=\"position:absolute;right:7%;top:36%;width:19%;height:46%;background:#1c2942;border:1px solid #33445f;border-radius:2px\"><\u002Fdiv>\n                  <div style=\"position:absolute;left:0;right:0;bottom:0;height:36%;background:linear-gradient(180deg,transparent,rgba(20,30,50,.65)),repeating-linear-gradient(90deg,transparent 0 40px,rgba(58,76,104,.14) 40px 41px)\"><\u002Fdiv>\n                  <div style=\"{{ rvGlow }}\"><\u002Fdiv>\n                  <div style=\"{{ rvFlame }}\"><\u002Fdiv>\n                  <div style=\"{{ rvBox }}\"><span style=\"position:absolute;top:-16px;left:0;font-family:'IBM Plex Mono',monospace;font-size:9px;color:#38bdf8;background:rgba(0,0,0,.55);padding:0 4px;border-radius:2px\">{{ rvBoxLabel }}<\u002Fspan><\u002Fdiv>\n                  <div style=\"position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(255,255,255,.03) 0 2px,transparent 2px 4px)\"><\u002Fdiv>\n                  <div style=\"position:absolute;top:11px;left:13px;font-family:'IBM Plex Mono',monospace;font-size:10px;color:#5fd0ff\">CAM-{{ rvShort }} · 1920×1080<\u002Fdiv>\n                  <div style=\"position:absolute;top:11px;right:13px;font-family:'IBM Plex Mono',monospace;font-size:10px;color:#5fd0ff;display:flex;align-items:center;gap:5px\"><span style=\"width:7px;height:7px;border-radius:50%;background:#ff4444;animation:pcPulse 1s infinite\"><\u002Fspan>REC {{ clock }}<\u002Fdiv>\n                  <div style=\"position:absolute;bottom:11px;left:13px;font-family:'IBM Plex Mono',monospace;font-size:10px;color:#5fd0ff\">{{ rvZone }} · inference 41ms<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n\n            <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04);overflow:hidden\">\n              <div style=\"display:flex;align-items:center;gap:9px;padding:15px 18px;border-bottom:1px solid #eef2f7\">\n                <span style=\"font-size:15px;font-weight:600;letter-spacing:-.2px\">LiDAR · 2D scan<\u002Fspan>\n                <span style=\"margin-left:auto;font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1px;color:#94a3b8;background:#f6f8fb;padding:4px 9px;border-radius:6px;border:1px solid #e6ebf2\">360° · 10Hz<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"padding:16px\">\n                <div style=\"position:relative;aspect-ratio:4/3;border-radius:12px;overflow:hidden;background:#0b1420;border:1px solid #dde3ec;display:flex;align-items:center;justify-content:center\">\n                  <svg sc-camel-view-box=\"0 0 200 150\" style=\"width:100%;height:100%\">\n                    <circle cx=\"100\" cy=\"75\" r=\"60\" fill=\"none\" stroke=\"#1c2b42\" stroke-width=\"1\"><\u002Fcircle>\n                    <circle cx=\"100\" cy=\"75\" r=\"40\" fill=\"none\" stroke=\"#1c2b42\" stroke-width=\"1\"><\u002Fcircle>\n                    <circle cx=\"100\" cy=\"75\" r=\"20\" fill=\"none\" stroke=\"#1c2b42\" stroke-width=\"1\"><\u002Fcircle>\n                    <polygon points=\"{{ lidar }}\" fill=\"rgba(56,189,248,.14)\" stroke=\"#38bdf8\" stroke-width=\"1.2\"><\u002Fpolygon>\n                    <circle cx=\"100\" cy=\"75\" r=\"4\" fill=\"#38bdf8\"><\u002Fcircle>\n                  <\u002Fsvg>\n                  <div style=\"position:absolute;inset:0;pointer-events:none;background:conic-gradient(from 0deg,rgba(56,189,248,.22),transparent 28%);animation:pcSweep 3s linear infinite\"><\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"{{ pairGrid }}\">\n            <div style=\"display:flex;flex-direction:column;background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n              <div style=\"padding:15px 18px;border-bottom:1px solid #eef2f7;font-size:15px;font-weight:600;letter-spacing:-.2px\">โซนที่รับผิดชอบ<\u002Fdiv>\n              <div style=\"padding:16px 18px;display:flex;flex-wrap:wrap;gap:8px\">\n                <sc-for list=\"{{ rvZones }}\" as=\"z\" hint-placeholder-count=\"2\">\n                  <span style=\"{{ z.chip }}\">{{ z.name }}<\u002Fspan>\n                <\u002Fsc-for>\n                <sc-if value=\"{{ rvNoZones }}\" hint-placeholder-val=\"{{ false }}\">\n                  <span style=\"font-size:12.5px;color:#94a3b8\">ยังไม่ได้กำหนดโซน — ตั้งค่าได้ที่หน้า System Control<\u002Fspan>\n                <\u002Fsc-if>\n              <\u002Fdiv>\n              <div style=\"margin-top:auto;padding:0 18px 18px;font-size:11.5px;color:#94a3b8;line-height:1.6;text-wrap:pretty\">สั่งงานหุ่นยนต์ได้ที่หน้า Robot Control · หน้านี้แสดงผลอย่างเดียว<\u002Fdiv>\n            <\u002Fdiv>\n\n            <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n              <div style=\"padding:15px 18px;border-bottom:1px solid #eef2f7;font-size:15px;font-weight:600;letter-spacing:-.2px\">ประวัติภารกิจ<\u002Fdiv>\n              <div style=\"padding:14px 18px;display:flex;flex-direction:column;gap:10px\">\n                <sc-for list=\"{{ rvMissions }}\" as=\"m\" hint-placeholder-count=\"3\">\n                  <div style=\"display:flex;align-items:center;gap:10px\">\n                    <span style=\"{{ m.dot }}\"><\u002Fspan>\n                    <span style=\"font-size:12.5px;color:#48566a;flex:1;min-width:0\">{{ m.text }}<\u002Fspan>\n                    <span style=\"font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#94a3b8\">{{ m.time }}<\u002Fspan>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n                <sc-if value=\"{{ rvNoMissions }}\" hint-placeholder-val=\"{{ true }}\">\n                  <span style=\"font-size:12.5px;color:#94a3b8\">ยังไม่มีภารกิจ — เริ่มซ้อมได้ที่หน้า Drill Mode<\u002Fspan>\n                <\u002Fsc-if>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"padding:15px 18px;border-bottom:1px solid #eef2f7;font-size:15px;font-weight:600;letter-spacing:-.2px\">Telemetry · {{ rvName }}<\u002Fdiv>\n            <div style=\"{{ telGrid }}\">\n              <sc-for list=\"{{ telemetry }}\" as=\"t\" hint-placeholder-count=\"6\">\n                <div style=\"background:#f6f8fb;border:1px solid #e6ebf2;border-radius:12px;padding:13px 14px\">\n                  <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:1.2px;color:#94a3b8;font-weight:600\">{{ t.k }}<\u002Fdiv>\n                  <div style=\"{{ t.style }}\">{{ t.v }}<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <sc-if value=\"{{ isLog }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Event Log\" style=\"{{ logGrid }}\">\n        <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04);overflow:hidden\">\n          <div style=\"display:flex;align-items:center;gap:9px;padding:15px 18px;border-bottom:1px solid #eef2f7\">\n            <span style=\"font-size:15px;font-weight:600;letter-spacing:-.2px\">ประวัติการตอบสนอง<\u002Fspan>\n            <span style=\"margin-left:auto;font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1px;color:#94a3b8;background:#f6f8fb;padding:4px 9px;border-radius:6px;border:1px solid #e6ebf2\">{{ eventCount }} EVENTS<\u002Fspan>\n          <\u002Fdiv>\n          <div style=\"display:flex;align-items:center;gap:7px;padding:13px 18px;border-bottom:1px solid #eef2f7;flex-wrap:wrap\">\n            <sc-for list=\"{{ logFilters }}\" as=\"f\" hint-placeholder-count=\"5\">\n              <button sc-camel-on-click=\"{{ f.onClick }}\" style=\"{{ f.style }}\">{{ f.label }}<\u002Fbutton>\n            <\u002Fsc-for>\n            <button sc-camel-on-click=\"{{ clearLog }}\" style=\"{{ clearLogStyle }}\" style-hover=\"background:#fef2f2\">\n              <svg width=\"13\" height=\"13\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v5M14 11v5\"><\u002Fpath><\u002Fsvg>\n              <span>ล้างบันทึก<\u002Fspan>\n            <\u002Fbutton>\n          <\u002Fdiv>\n          <sc-raw-table style=\"width:100%;border-collapse:collapse\">\n            <sc-raw-thead>\n              <sc-raw-tr>\n                <sc-raw-th style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1.2px;text-transform:uppercase;color:#94a3b8;text-align:left;padding:12px 18px;border-bottom:1px solid #e6ebf2;font-weight:600\">Time<\u002Fsc-raw-th>\n                <sc-raw-th style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1.2px;text-transform:uppercase;color:#94a3b8;text-align:left;padding:12px 10px;border-bottom:1px solid #e6ebf2;font-weight:600\">Zone<\u002Fsc-raw-th>\n                <sc-raw-th style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1.2px;text-transform:uppercase;color:#94a3b8;text-align:left;padding:12px 10px;border-bottom:1px solid #e6ebf2;font-weight:600\">Stage<\u002Fsc-raw-th>\n                <sc-raw-th style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1.2px;text-transform:uppercase;color:#94a3b8;text-align:left;padding:12px 18px;border-bottom:1px solid #e6ebf2;font-weight:600\">Detail<\u002Fsc-raw-th>\n              <\u002Fsc-raw-tr>\n            <\u002Fsc-raw-thead>\n            <sc-raw-tbody>\n              <sc-for list=\"{{ events }}\" as=\"e\" hint-placeholder-count=\"6\">\n                <sc-raw-tr>\n                  <sc-raw-td style=\"padding:12px 18px;border-bottom:1px solid #f1f5f9;font-family:'IBM Plex Mono',monospace;font-size:12px;color:#8494a8\">{{ e.time }}<\u002Fsc-raw-td>\n                  <sc-raw-td style=\"padding:12px 10px;border-bottom:1px solid #f1f5f9\"><span style=\"font-weight:600;font-size:13px;display:inline-block;line-height:1.7;background:#f6f8fb;border:1px solid #e6ebf2;border-radius:8px;padding:3px 11px;white-space:nowrap\">{{ e.zone }}<\u002Fspan><\u002Fsc-raw-td>\n                  <sc-raw-td style=\"padding:12px 10px;border-bottom:1px solid #f1f5f9\"><span style=\"{{ e.tagStyle }}\">{{ e.tag }}<\u002Fspan><\u002Fsc-raw-td>\n                  <sc-raw-td style=\"padding:12px 18px;border-bottom:1px solid #f1f5f9;font-size:13px;color:#48566a\">{{ e.text }}<\u002Fsc-raw-td>\n                <\u002Fsc-raw-tr>\n              <\u002Fsc-for>\n            <\u002Fsc-raw-tbody>\n          <\u002Fsc-raw-table>\n          <sc-if value=\"{{ noEvents }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"padding:34px 18px;text-align:center;color:#94a3b8;font-size:13px\">ยังไม่มีเหตุการณ์ · จำลองเหตุไฟไหม้จากหน้าภาพรวมสด<\u002Fdiv>\n          <\u002Fsc-if>\n        <\u002Fdiv>\n\n        <div style=\"display:flex;flex-direction:column;gap:16px\">\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"padding:15px 18px;border-bottom:1px solid #eef2f7;font-size:15px;font-weight:600;letter-spacing:-.2px\">เวลาตอบสนอง · เทียบระบบเดิม<\u002Fdiv>\n            <div style=\"padding:20px 18px\">\n              <div style=\"margin-bottom:20px\">\n                <div style=\"display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px\">\n                  <span style=\"font-size:14.5px;font-weight:600\">Pancabo · หุ่นยนต์อัตโนมัติ<\u002Fspan>\n                  <span style=\"font-family:'IBM Plex Mono',monospace;font-size:12px;color:#2563eb;font-weight:600\">{{ ourSecs }}s<\u002Fspan>\n                <\u002Fdiv>\n                <div style=\"height:30px;border-radius:9px;background:#f1f5f9;overflow:hidden;border:1px solid #e6ebf2\"><i style=\"display:block;height:100%;width:11%;border-radius:8px;background:linear-gradient(90deg,#2563eb,#60a5fa);box-shadow:0 0 14px rgba(37,99,235,.4)\"><\u002Fi><\u002Fdiv>\n              <\u002Fdiv>\n              <div>\n                <div style=\"display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px\">\n                  <span style=\"font-size:14.5px;font-weight:600\">Sprinkler + เจ้าหน้าที่<\u002Fspan>\n                  <span style=\"font-family:'IBM Plex Mono',monospace;font-size:12px;color:#8494a8\">~185s<\u002Fspan>\n                <\u002Fdiv>\n                <div style=\"height:30px;border-radius:9px;background:#f1f5f9;overflow:hidden;border:1px solid #e6ebf2\"><i style=\"display:block;height:100%;width:100%;border-radius:8px;background:linear-gradient(90deg,#f59e0b,#fbbf24)\"><\u002Fi><\u002Fdiv>\n              <\u002Fdiv>\n              <p style=\"font-size:12.5px;color:#48566a;line-height:1.7;margin-top:14px;text-wrap:pretty\">การตัดสินใจเกิดขึ้นบน edge ทั้งหมด — ไม่ต้องรอ cloud round-trip จึงลดเวลาจากตรวจพบถึงฉีดสารดับได้ราว <b style=\"color:#2563eb\">95%<\u002Fb> เมื่อเทียบกับการรอเจ้าหน้าที่<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding:0 18px 20px\">\n              <sc-for list=\"{{ stats }}\" as=\"s\" hint-placeholder-count=\"3\">\n                <div style=\"background:#f6f8fb;border:1px solid #e6ebf2;border-radius:12px;padding:14px;text-align:center\">\n                  <div style=\"font-size:25px;font-weight:700;line-height:1;letter-spacing:-.6px\">{{ s.v }}<span style=\"font-size:13px;color:#8494a8\">{{ s.u }}<\u002Fspan><\u002Fdiv>\n                  <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9px;color:#94a3b8;margin-top:6px;text-transform:uppercase;letter-spacing:1px;font-weight:600\">{{ s.l }}<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04);padding:16px 18px;display:flex;align-items:center;gap:14px\">\n            <div style=\"width:44px;height:44px;border-radius:12px;flex:none;background:#e6f5fd;border:1px solid rgba(14,165,233,.3);display:flex;align-items:center;justify-content:center\">\n              <svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0ea5e9\" stroke-width=\"1.9\" stroke-linecap=\"round\"><path d=\"M12 3v10M9 6a3 3 0 0 1 6 0v4a3 3 0 0 1-6 0zM5 11a7 7 0 0 0 14 0M12 18v3\"><\u002Fpath><\u002Fsvg>\n            <\u002Fdiv>\n            <div style=\"font-size:12.5px;color:#48566a;line-height:1.6\">รายงานเสียงอัตโนมัติส่งเข้าวิทยุสื่อสารเมื่อจบเหตุ <b style=\"color:#0e1726;font-weight:600\">\"โซน {{ lastZone }} ควบคุมเพลิงได้แล้ว\"<\u002Fb><span style=\"font-family:'IBM Plex Mono',monospace;font-size:9px;color:#94a3b8;border:1px solid #e6ebf2;padding:2px 7px;border-radius:5px;margin-left:6px\">PHASE 2<\u002Fspan><\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <sc-if value=\"{{ isCtrl }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Control\" style=\"{{ ctrlGrid }}\">\n\n        <div style=\"display:flex;flex-direction:column;gap:16px\">\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"padding:15px 18px;border-bottom:1px solid #eef2f7;font-size:15px;font-weight:600;letter-spacing:-.2px\">เกณฑ์การตัดสินใจ<\u002Fdiv>\n            <div style=\"padding:18px\">\n              <div style=\"margin-bottom:20px\">\n                <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#94a3b8;margin-bottom:9px;text-transform:uppercase\">Fusion threshold · สัญญาณขั้นต่ำ<\u002Fdiv>\n                <div style=\"display:flex;gap:7px\">\n                  <sc-for list=\"{{ thrOpts }}\" as=\"t\" hint-placeholder-count=\"4\">\n                    <button sc-camel-on-click=\"{{ t.onClick }}\" style=\"{{ t.style }}\">{{ t.label }}<\u002Fbutton>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"margin-bottom:20px\">\n                <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#94a3b8;margin-bottom:9px;text-transform:uppercase\">โหมดปฏิบัติการ<\u002Fdiv>\n                <div style=\"display:flex;gap:7px\">\n                  <sc-for list=\"{{ modeOpts }}\" as=\"m\" hint-placeholder-count=\"2\">\n                    <button sc-camel-on-click=\"{{ m.onClick }}\" style=\"{{ m.style }}\">{{ m.label }}<\u002Fbutton>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n\n              <div style=\"margin-bottom:20px\">\n                <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#94a3b8;margin-bottom:6px;text-transform:uppercase\">แบตต่ำ · กลับแท่นชาร์จเมื่อ<\u002Fdiv>\n                <p style=\"font-size:12px;color:#64748b;line-height:1.6;margin-bottom:9px;text-wrap:pretty\">หุ่นยนต์ที่กำลังลาดตระเวนจะกลับแท่นชาร์จอัตโนมัติเมื่อแบตเตอรี่ต่ำกว่า {{ batLowNow }}<\u002Fp>\n                <div style=\"display:flex;gap:7px\">\n                  <sc-for list=\"{{ batLowOpts }}\" as=\"v\" hint-placeholder-count=\"5\">\n                    <button sc-camel-on-click=\"{{ v.onClick }}\" style=\"{{ v.style }}\">{{ v.label }}<\u002Fbutton>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n\n              <div>\n                <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#94a3b8;margin-bottom:6px;text-transform:uppercase\">ชาร์จจนถึง · กลับไปลาดตระเวน<\u002Fdiv>\n                <p style=\"font-size:12px;color:#64748b;line-height:1.6;margin-bottom:9px;text-wrap:pretty\">ออกจากแท่นชาร์จเมื่อแบตเตอรี่ถึง {{ batFullNow }}<\u002Fp>\n                <div style=\"display:flex;gap:7px\">\n                  <sc-for list=\"{{ batFullOpts }}\" as=\"v\" hint-placeholder-count=\"4\">\n                    <button sc-camel-on-click=\"{{ v.onClick }}\" style=\"{{ v.style }}\">{{ v.label }}<\u002Fbutton>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"padding:15px 18px;border-bottom:1px solid #eef2f7;font-size:15px;font-weight:600;letter-spacing:-.2px\">สารดับตามชนิดพื้นที่<\u002Fdiv>\n            <div>\n              <sc-for list=\"{{ agentMap }}\" as=\"a\" hint-placeholder-count=\"4\">\n                <div style=\"display:flex;align-items:center;gap:12px;padding:13px 18px;border-bottom:1px solid #f1f5f9\">\n                  <span style=\"font-weight:600;font-size:13.5px;width:64px;flex:none\">{{ a.zone }}<\u002Fspan>\n                  <span style=\"font-size:12.5px;color:#8494a8;flex:1;min-width:0\">{{ a.type }}<\u002Fspan>\n                  <span style=\"{{ a.pill }}\">{{ a.agent }}<\u002Fspan>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <div style=\"display:flex;flex-direction:column;gap:16px\">\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"padding:15px 18px;border-bottom:1px solid #eef2f7;font-size:15px;font-weight:600;letter-spacing:-.2px\">แผนลาดตระเวน · Patrol assignment<\u002Fdiv>\n            <div>\n              <sc-for list=\"{{ assignRows }}\" as=\"r\" hint-placeholder-count=\"3\">\n                <div style=\"display:flex;align-items:center;gap:12px;padding:14px 18px;border-bottom:1px solid #f1f5f9\">\n                  <div style=\"{{ r.badge }}\">{{ r.short }}<\u002Fdiv>\n                  <div style=\"width:88px;flex:none\">\n                    <div style=\"font-size:13.5px;font-weight:600\">{{ r.name }}<\u002Fdiv>\n                    <div style=\"font-family:'IBM Plex Mono',monospace;font-size:10px;color:#8494a8\">{{ r.agent }}<\u002Fdiv>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;gap:6px;flex:1;flex-wrap:wrap\">\n                    <sc-for list=\"{{ r.chips }}\" as=\"c\" hint-placeholder-count=\"4\">\n                      <button sc-camel-on-click=\"{{ c.onClick }}\" style=\"{{ c.style }}\">{{ c.label }}<\u002Fbutton>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"padding:15px 18px;border-bottom:1px solid #eef2f7;font-size:15px;font-weight:600;letter-spacing:-.2px\">จัดการหุ่นยนต์<\u002Fdiv>\n            <div style=\"padding:14px 18px;display:flex;flex-direction:column;gap:11px\">\n              <sc-for list=\"{{ robotRows }}\" as=\"r\" hint-placeholder-count=\"3\">\n                <div style=\"{{ r.card }}\">\n                  <div style=\"display:flex;align-items:center;gap:11px\">\n                    <div style=\"{{ r.badge }}\">{{ r.short }}<\u002Fdiv>\n                    <div style=\"flex:1;min-width:0;display:flex;flex-direction:column;gap:3px\">\n                      <input value=\"{{ r.name }}\" sc-camel-on-change=\"{{ r.onName }}\" style=\"{{ r.input }}\">\n                      <span style=\"{{ r.serialStyle }}\">{{ r.serial }}<\u002Fspan>\n                    <\u002Fdiv>\n                    <span style=\"{{ r.pill }}\">{{ r.state }}<\u002Fspan>\n                    <div style=\"display:flex;align-items:center;gap:6px;flex:none\">\n                      <div style=\"width:36px;height:5px;border-radius:3px;background:#e6ebf2;overflow:hidden\"><i style=\"{{ r.batBar }}\"><\u002Fi><\u002Fdiv>\n                      <span style=\"font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#8494a8;width:30px\">{{ r.bat }}%<\u002Fspan>\n                    <\u002Fdiv>\n                    <button sc-camel-on-click=\"{{ r.onDelete }}\" style=\"{{ r.del }}\" style-hover=\"color:#dc2626;border-color:#fca5a5\">✕<\u002Fbutton>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding-top:11px;margin-top:11px;border-top:1px solid #eef2f7\">\n                    <span style=\"{{ r.fieldLabel }}\">สารดับ<\u002Fspan>\n                    <div style=\"display:flex;gap:6px\">\n                      <sc-for list=\"{{ r.agentBtns }}\" as=\"a\" hint-placeholder-count=\"3\">\n                        <button sc-camel-on-click=\"{{ a.onClick }}\" style=\"{{ a.style }}\">{{ a.label }}<\u002Fbutton>\n                      <\u002Fsc-for>\n                    <\u002Fdiv>\n                    <span style=\"{{ r.fieldLabel }}\">คำสั่ง<\u002Fspan>\n                    <div style=\"display:flex;gap:6px\">\n                      <sc-for list=\"{{ r.cmds }}\" as=\"c\" hint-placeholder-count=\"2\">\n                        <button sc-camel-on-click=\"{{ c.onClick }}\" style=\"{{ c.style }}\">{{ c.label }}<\u002Fbutton>\n                      <\u002Fsc-for>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n              <button sc-camel-on-click=\"{{ addRobot }}\" style=\"{{ addBtn }}\">+ เพิ่มหุ่นยนต์ (สแกน QR)<\u002Fbutton>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04);padding:16px 18px;display:flex;align-items:center;gap:12px\">\n            <div style=\"font-size:12.5px;color:#8494a8;line-height:1.6;flex:1;text-wrap:pretty\">การจำลองเหตุไฟไหม้ย้ายไปที่หน้า <b style=\"color:#0e1726;font-weight:600\">Drill Mode · โหมดซ้อมดับเพลิง<\u002Fb><\u002Fdiv>\n            <button sc-camel-on-click=\"{{ goDrill }}\" style=\"padding:10px 16px;border-radius:10px;border:1px solid #e2e8f2;background:#fff;color:#48566a;font-family:'Prompt',sans-serif;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap\">ไปที่หน้าซ้อม<\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <sc-if value=\"{{ isMaps }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Map Builder\" style=\"{{ ctrlGrid }}\">\n\n        <div style=\"display:flex;flex-direction:column;gap:16px\">\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"display:flex;align-items:center;gap:10px;padding:15px 18px;border-bottom:1px solid #eef2f7\">\n              <span style=\"font-size:15px;font-weight:600;letter-spacing:-.2px\">คลังผังอาคาร<\u002Fspan>\n              <button sc-camel-on-click=\"{{ openWizard }}\" style=\"{{ newBldBtn }}\" style-hover=\"border-color:#2563eb;color:#2563eb\">+ สร้างแผนผังใหม่<\u002Fbutton>\n            <\u002Fdiv>\n            <div style=\"padding:16px 18px\">\n              <p style=\"font-size:12.5px;color:#8494a8;line-height:1.6;margin-bottom:13px;text-wrap:pretty\">สร้างแผนผังได้ 2 วิธี — อัปโหลดไฟล์ occupancy grid (.pgm) หรือภาพแปลนพื้น หรือให้หุ่นยนต์ขับสำรวจพื้นที่แล้วสร้างแผนผังให้อัตโนมัติ<\u002Fp>\n              <div style=\"display:flex;gap:10px;flex-wrap:wrap\">\n                <sc-for list=\"{{ mapCollection }}\" as=\"m\" hint-placeholder-count=\"3\">\n                  <div sc-camel-on-click=\"{{ m.onClick }}\" style=\"{{ m.card }}\">\n                    <div style=\"{{ m.thumb }}\">\n                      <sc-for list=\"{{ m.zones }}\" as=\"z\" hint-placeholder-count=\"4\">\n                        <div style=\"{{ z.box }}\"><\u002Fdiv>\n                      <\u002Fsc-for>\n                      <svg sc-camel-view-box=\"0 0 100 100\" sc-camel-preserve-aspect-ratio=\"none\" style=\"position:absolute;inset:0;width:100%;height:100%;pointer-events:none\">\n                        <sc-for list=\"{{ m.walls }}\" as=\"w\" hint-placeholder-count=\"0\">\n                          <line x1=\"{{ w.x1 }}\" y1=\"{{ w.y1 }}\" x2=\"{{ w.x2 }}\" y2=\"{{ w.y2 }}\" vector-effect=\"non-scaling-stroke\" style=\"{{ wallThumbStyle }}\"><\u002Fline>\n                        <\u002Fsc-for>\n                      <\u002Fsvg>\n                    <\u002Fdiv>\n                    <div style=\"{{ m.nameStyle }}\">{{ m.name }}<\u002Fdiv>\n                    <div style=\"{{ m.countStyle }}\">{{ m.count }}<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"display:flex;flex-direction:column;background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04);overflow:hidden\">\n            <div style=\"display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid #eef2f7;min-width:0\">\n              <span style=\"font-size:15px;font-weight:600;letter-spacing:-.2px;white-space:nowrap\">แก้ไขผัง · {{ bldName }}<\u002Fspan>\n              <div style=\"margin-left:auto;display:flex;align-items:center;gap:8px;flex:none\">\n                <span style=\"{{ saveStyle }}\">{{ saveLabel }}<\u002Fspan>\n                <button sc-camel-on-click=\"{{ toggleEdit }}\" style=\"{{ editBtn }}\">{{ editBtnLabel }}<\u002Fbutton>\n              <\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"padding:14px 16px 16px;display:flex;flex-direction:column;gap:11px\">\n              <input ref=\"{{ planRef }}\" type=\"file\" accept=\".pgm,image/*\" sc-camel-on-change=\"{{ onPlanFile }}\" style=\"{{ planFileInput }}\">\n              <div style=\"{{ toolRail }}\">\n                <sc-for list=\"{{ tools }}\" as=\"t\" hint-placeholder-count=\"2\">\n                  <button sc-camel-on-click=\"{{ t.onClick }}\" style=\"{{ t.style }}\" title=\"{{ t.title }}\">\n                    <span style=\"{{ t.iconStyle }}\">{{ t.icon }}<\u002Fspan>\n                    <span>{{ t.label }}<\u002Fspan>\n                  <\u002Fbutton>\n                <\u002Fsc-for>\n                <span style=\"width:1px;height:26px;background:#e2e8f2\"><\u002Fspan>\n                <button sc-camel-on-click=\"{{ toggleMenu }}\" style=\"{{ menuBtn }}\" title=\"ตัวเลือกเพิ่มเติม\">⋯<\u002Fbutton>\n                <span style=\"{{ railHint }}\">{{ railHintText }}<\u002Fspan>\n                <div style=\"{{ menuPanel }}\">\n                  <sc-for list=\"{{ menuItems }}\" as=\"m\" hint-placeholder-count=\"4\">\n                    <button sc-camel-on-click=\"{{ m.onClick }}\" style=\"{{ m.style }}\" style-hover=\"background:#f6f8fb\">{{ m.label }}<\u002Fbutton>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n              <div ref=\"{{ mapRef }}\" style=\"position:relative;width:100%;height:330px;border-radius:13px;overflow:hidden;background:#f5f8fb;border:1px solid #e6ebf2;background-image:linear-gradient(#eaeff6 1px,transparent 1px),linear-gradient(90deg,#eaeff6 1px,transparent 1px);background-size:34px 34px\">\n                <div style=\"{{ planStyle }}\"><\u002Fdiv>\n                <svg style=\"{{ wallSvg }}\" sc-camel-preserve-aspect-ratio=\"none\" sc-camel-view-box=\"0 0 100 100\">\n                  <sc-for list=\"{{ walls }}\" as=\"w\" hint-placeholder-count=\"0\">\n                    <line x1=\"{{ w.x1 }}\" y1=\"{{ w.y1 }}\" x2=\"{{ w.x2 }}\" y2=\"{{ w.y2 }}\" vector-effect=\"non-scaling-stroke\" sc-camel-on-click=\"{{ w.onClick }}\" style=\"{{ w.style }}\"><\u002Fline>\n                  <\u002Fsc-for>\n                  <line x1=\"{{ draftWall.x1 }}\" y1=\"{{ draftWall.y1 }}\" x2=\"{{ draftWall.x2 }}\" y2=\"{{ draftWall.y2 }}\" vector-effect=\"non-scaling-stroke\" style=\"{{ draftStyle }}\"><\u002Fline>\n                <\u002Fsvg>\n                <div sc-camel-on-pointer-down=\"{{ onMapDown }}\" style=\"{{ drawLayer }}\"><\u002Fdiv>\n                <sc-for list=\"{{ mapZones }}\" as=\"z\" hint-placeholder-count=\"4\">\n                  <div sc-camel-on-pointer-down=\"{{ z.onDragStart }}\" style=\"{{ z.box }}\">\n                    <button sc-camel-on-pointer-down=\"{{ z.onDelDown }}\" sc-camel-on-click=\"{{ z.onDelete }}\" style=\"{{ z.delStyle }}\">✕<\u002Fbutton>\n                    <div sc-camel-on-pointer-down=\"{{ z.onResizeStart }}\" style=\"{{ z.handleStyle }}\"><\u002Fdiv>\n                    <div style=\"display:flex;align-items:center;gap:7px\">\n                      <div style=\"{{ z.nameStyle }}\">{{ z.name }}<\u002Fdiv>\n                    <\u002Fdiv>\n                    <div style=\"font-size:10.5px;color:#8494a8;margin-top:1px\">{{ z.type }}<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"padding:15px 18px;border-bottom:1px solid #eef2f7;font-size:15px;font-weight:600;letter-spacing:-.2px\">จัดการอาคารและชื่อไซต์<\u002Fdiv>\n            <div style=\"padding:14px 18px;display:flex;flex-direction:column;gap:9px\">\n              <sc-for list=\"{{ bldRows }}\" as=\"b\" hint-placeholder-count=\"2\">\n                <div style=\"display:flex;align-items:center;gap:8px\">\n                  <input value=\"{{ b.name }}\" sc-camel-on-change=\"{{ b.onName }}\" style=\"{{ b.input }}\">\n                  <span style=\"font-family:'IBM Plex Mono',monospace;font-size:11px;color:#94a3b8;width:52px;flex:none;text-align:right\">{{ b.count }}<\u002Fspan>\n                  <button sc-camel-on-click=\"{{ b.onDelete }}\" style=\"{{ b.del }}\" style-hover=\"color:#dc2626;border-color:#fca5a5\">✕<\u002Fbutton>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n              <div style=\"display:flex;align-items:center;gap:8px;padding-top:5px;border-top:1px solid #f1f5f9\">\n                <span style=\"font-size:12.5px;color:#8494a8;width:66px;flex:none\">ชื่อไซต์<\u002Fspan>\n                <input value=\"{{ siteName }}\" sc-camel-on-change=\"{{ onSiteName }}\" style=\"{{ siteInput }}\">\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <div style=\"display:flex;flex-direction:column;gap:16px\">\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"padding:15px 18px;border-bottom:1px solid #eef2f7;font-size:15px;font-weight:600;letter-spacing:-.2px\">จัดการโซนใน {{ bldName }}<\u002Fdiv>\n            <div style=\"padding:14px 18px;display:flex;flex-direction:column;gap:9px\">\n              <sc-for list=\"{{ zoneRows }}\" as=\"z\" hint-placeholder-count=\"4\">\n                <div style=\"display:flex;align-items:center;gap:8px\">\n                  <input value=\"{{ z.name }}\" sc-camel-on-change=\"{{ z.onName }}\" style=\"{{ z.input }}\">\n                  <input value=\"{{ z.type }}\" sc-camel-on-change=\"{{ z.onType }}\" style=\"{{ z.input }}\">\n                  <button sc-camel-on-click=\"{{ z.onDelete }}\" style=\"{{ z.del }}\" style-hover=\"color:#dc2626;border-color:#fca5a5\">✕<\u002Fbutton>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n              <div style=\"display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding-top:9px;border-top:1px solid #f1f5f9\">\n                <input ref=\"{{ zRef }}\" placeholder=\"ชื่อโซน เช่น โซน E\" style=\"flex:1;min-width:130px;padding:10px 12px;border-radius:9px;border:1px solid #dde3ec;font-family:'Prompt',sans-serif;font-size:13px;color:#0e1726;outline:none\">\n                <input ref=\"{{ tRef }}\" placeholder=\"ชนิดพื้นที่\" style=\"flex:1;min-width:130px;padding:10px 12px;border-radius:9px;border:1px solid #dde3ec;font-family:'Prompt',sans-serif;font-size:13px;color:#0e1726;outline:none\">\n                <button sc-camel-on-click=\"{{ addZone }}\" style=\"padding:10px 16px;border-radius:9px;border:none;background:#2563eb;color:#fff;font-family:'Prompt',sans-serif;font-weight:600;font-size:13px;cursor:pointer\">เพิ่มโซน<\u002Fbutton>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04);padding:16px 18px;display:flex;align-items:center;gap:12px\">\n            <div style=\"font-size:12.5px;color:#8494a8;line-height:1.6;flex:1;text-wrap:pretty\">กด <b style=\"color:#0e1726;font-weight:600\">แก้ไขผัง<\u002Fb> ด้านบนเพื่อย้าย ปรับขนาด หรือวาดกำแพงบนแผนผัง · ทุกการเปลี่ยนแปลงบันทึกอัตโนมัติ<\u002Fdiv>\n            <div style=\"{{ saveStyle }}\">{{ saveLabel }}<\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <sc-if value=\"{{ isDrill }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Drill Mode\" style=\"{{ ctrlGrid }}\">\n\n        <div style=\"display:flex;flex-direction:column;gap:16px\">\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"display:flex;align-items:center;gap:9px;padding:15px 18px;border-bottom:1px solid #eef2f7\">\n              <span style=\"font-size:15px;font-weight:600;letter-spacing:-.2px\">ตั้งค่าการซ้อม<\u002Fspan>\n              <span style=\"{{ mapBadge }}\">{{ mapBadgeText }}<\u002Fspan>\n            <\u002Fdiv>\n            <div style=\"padding:18px\">\n              <p style=\"font-size:12.5px;color:#8494a8;line-height:1.7;margin-bottom:14px;text-wrap:pretty\">เลือกโซนต้นเพลิงแล้วเริ่มซ้อม — ค่าเซ็นเซอร์จะไต่ขึ้นจริง ระบบจะตัดสินใจ ส่งหุ่นยนต์ และจับเวลาให้ทั้งหมด<\u002Fp>\n              <div style=\"display:flex;align-items:flex-start;gap:10px;margin-bottom:14px\">\n                <span style=\"font-size:12.5px;color:#48566a;width:80px;flex:none;padding-top:7px\">โซนต้นเพลิง<\u002Fspan>\n                <div style=\"display:flex;gap:6px;flex-wrap:wrap\">\n                  <sc-for list=\"{{ simZones }}\" as=\"z\" hint-placeholder-count=\"4\">\n                    <button sc-camel-on-click=\"{{ z.onClick }}\" style=\"{{ z.style }}\">{{ z.label }}<\u002Fbutton>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n              <button sc-camel-on-click=\"{{ trigger }}\" style=\"{{ simBtn }}\">{{ simBtnLabel }}<\u002Fbutton>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"padding:15px 18px;border-bottom:1px solid #eef2f7;font-size:15px;font-weight:600;letter-spacing:-.2px\">ลำดับขั้นการตอบสนอง<\u002Fdiv>\n            <div style=\"padding:16px 18px;display:flex;flex-direction:column;gap:10px\">\n              <sc-for list=\"{{ trace }}\" as=\"t\" hint-placeholder-count=\"4\">\n                <div style=\"display:flex;align-items:center;gap:11px;padding:11px 13px;border-radius:11px;background:#f6f8fb;border:1px solid #e6ebf2\">\n                  <span style=\"{{ t.dot }}\"><\u002Fspan>\n                  <span style=\"{{ t.text }}\">{{ t.label }}<\u002Fspan>\n                  <span style=\"margin-left:auto;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#94a3b8\">{{ t.at }}<\u002Fspan>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <div style=\"display:flex;flex-direction:column;gap:16px\">\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04);padding:20px 18px\">\n            <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:1.4px;color:#94a3b8;font-weight:600\">ELAPSED<\u002Fdiv>\n            <div style=\"display:flex;align-items:baseline;gap:9px;margin-top:6px\">\n              <div style=\"{{ drillClockStyle }}\">{{ drillClock }}<\u002Fdiv>\n              <div style=\"font-size:13px;color:#8494a8\">{{ drillPhase }}<\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:18px\">\n              <sc-for list=\"{{ stats }}\" as=\"s\" hint-placeholder-count=\"3\">\n                <div style=\"background:#f6f8fb;border:1px solid #e6ebf2;border-radius:12px;padding:14px;text-align:center\">\n                  <div style=\"font-size:25px;font-weight:700;line-height:1;letter-spacing:-.6px\">{{ s.v }}<span style=\"font-size:13px;color:#8494a8\">{{ s.u }}<\u002Fspan><\u002Fdiv>\n                  <div style=\"font-family:'IBM Plex Mono',monospace;font-size:9px;color:#94a3b8;margin-top:6px;text-transform:uppercase;letter-spacing:1px;font-weight:600\">{{ s.l }}<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"background:#fff;border:1px solid #e2e8f2;border-radius:16px;box-shadow:0 1px 2px rgba(14,23,38,.04)\">\n            <div style=\"padding:15px 18px;border-bottom:1px solid #eef2f7;font-size:15px;font-weight:600;letter-spacing:-.2px\">สถานะกองหุ่นยนต์ระหว่างซ้อม<\u002Fdiv>\n            <div style=\"padding:14px;display:flex;flex-direction:column;gap:10px\">\n              <sc-for list=\"{{ fleet }}\" as=\"r\" hint-placeholder-count=\"3\">\n                <div sc-camel-on-click=\"{{ r.onClick }}\" style=\"{{ r.row }}\">\n                  <div style=\"{{ r.badge }}\">{{ r.short }}<\u002Fdiv>\n                  <div style=\"flex:1;min-width:0\">\n                    <div style=\"font-size:13px;font-weight:600\">{{ r.name }}<\u002Fdiv>\n                    <div style=\"font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#8494a8\">{{ r.zoneLabel }} · {{ r.agent }}<\u002Fdiv>\n                  <\u002Fdiv>\n                  <span style=\"{{ r.pill }}\">{{ r.state }}<\u002Fspan>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <\u002Fsc-if>\n\n    <\u002Fmain>\n  <\u002Fdiv>\n\n  <sc-if value=\"{{ loading }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"position:fixed;inset:0;z-index:300;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;background:rgba(233,237,243,.92);backdrop-filter:blur(6px)\">\n      <img src=\"a96ce09c-8281-48f8-943b-50d7ed77f2a1\" alt=\"pancabo\" style=\"width:132px;height:auto;opacity:.9;animation:pcPulse 1.5s infinite\">\n      <div style=\"width:236px;height:6px;border-radius:3px;background:#dbe2ec;overflow:hidden\">\n        <div style=\"{{ loadBar }}\"><\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"display:flex;align-items:center;gap:9px\">\n        <span style=\"font-size:13px;color:#48566a\">{{ loadMsg }}<\u002Fspan>\n        <span style=\"font-family:'IBM Plex Mono',monospace;font-size:12px;color:#2563eb;font-weight:600\">{{ loadPctText }}<\u002Fspan>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ confirmOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"position:fixed;inset:0;z-index:280;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(12,20,33,.5);backdrop-filter:blur(3px);animation:pcRise .18s ease\">\n      <div style=\"width:100%;max-width:410px;background:#fff;border-radius:18px;box-shadow:0 26px 60px rgba(12,20,33,.35);padding:22px\">\n        <div style=\"display:flex;align-items:flex-start;gap:13px\">\n          <div style=\"width:40px;height:40px;flex:none;border-radius:12px;background:#fef2f2;border:1px solid #fecaca;display:flex;align-items:center;justify-content:center\">\n            <svg width=\"19\" height=\"19\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#dc2626\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 8v5M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z\"><\u002Fpath><\u002Fsvg>\n          <\u002Fdiv>\n          <div style=\"flex:1;min-width:0\">\n            <div style=\"font-size:16px;font-weight:600;letter-spacing:-.2px\">{{ confirmTitle }}<\u002Fdiv>\n            <p style=\"font-size:13px;color:#64748b;line-height:1.65;margin-top:5px;text-wrap:pretty\">{{ confirmBody }}<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:flex;gap:10px;margin-top:19px\">\n          <button sc-camel-on-click=\"{{ confirmCancel }}\" style=\"flex:1;padding:11px;border-radius:10px;border:1px solid #e2e8f2;background:#fff;color:#48566a;font-family:'Prompt',sans-serif;font-size:13.5px;font-weight:600;cursor:pointer\">ยกเลิก<\u002Fbutton>\n          <button sc-camel-on-click=\"{{ confirmRun }}\" style=\"flex:1;padding:11px;border-radius:10px;border:none;background:#dc2626;color:#fff;font-family:'Prompt',sans-serif;font-size:13.5px;font-weight:600;cursor:pointer;box-shadow:0 5px 14px rgba(220,38,38,.3)\">{{ confirmLabel }}<\u002Fbutton>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ needApproval }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"position:fixed;inset:0;z-index:260;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(70,10,10,.42);backdrop-filter:blur(3px);animation:pcRise .2s ease\">\n      <div style=\"width:100%;max-width:480px;background:#fff;border-radius:20px;box-shadow:0 30px 70px rgba(12,20,33,.4);overflow:hidden\">\n        <div style=\"display:flex;align-items:center;gap:12px;padding:18px 22px;background:linear-gradient(90deg,#dc2626,#ef4444);color:#fff\">\n          <span style=\"width:10px;height:10px;border-radius:50%;background:#fff;animation:pcPulse .8s infinite;flex:none\"><\u002Fspan>\n          <div>\n            <div style=\"font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:2px;opacity:.85\">OPERATOR CONFIRMATION<\u002Fdiv>\n            <div style=\"font-size:18px;font-weight:700;letter-spacing:-.3px\">ยืนยันการส่งหุ่นยนต์เข้าระงับเหตุ<\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"padding:20px 22px;display:flex;flex-direction:column;gap:13px\">\n          <p style=\"font-size:13px;color:#48566a;line-height:1.7;text-wrap:pretty\">ระบบตรวจพบเหตุเพลิงไหม้และหยุดรอการอนุมัติ เนื่องจากตั้งค่าโหมดปฏิบัติการเป็น <b style=\"color:#0e1726;font-weight:600\">รอผู้ควบคุมยืนยัน<\u002Fb><\u002Fp>\n          <div style=\"display:flex;flex-direction:column;gap:9px;padding:14px 16px;border-radius:13px;background:#f6f8fb;border:1px solid #e6ebf2\">\n            <div style=\"display:flex;align-items:center;gap:10px\"><span style=\"font-size:12.5px;color:#64748b;width:92px;flex:none\">โซน<\u002Fspan><span style=\"font-size:13.5px;font-weight:600\">{{ apZone }}<\u002Fspan><\u002Fdiv>\n            <div style=\"display:flex;align-items:center;gap:10px\"><span style=\"font-size:12.5px;color:#64748b;width:92px;flex:none\">สารดับที่เลือก<\u002Fspan><span style=\"font-size:13.5px;font-weight:600\">{{ apAgent }}<\u002Fspan><\u002Fdiv>\n            <div style=\"display:flex;align-items:center;gap:10px\"><span style=\"font-size:12.5px;color:#64748b;width:92px;flex:none\">Sensor fusion<\u002Fspan><span style=\"font-family:'IBM Plex Mono',monospace;font-size:13px;font-weight:600;color:#dc2626\">{{ apFusion }}<\u002Fspan><\u002Fdiv>\n            <div style=\"display:flex;align-items:center;gap:10px\"><span style=\"font-size:12.5px;color:#64748b;width:92px;flex:none\">AI confidence<\u002Fspan><span style=\"font-family:'IBM Plex Mono',monospace;font-size:13px;font-weight:600\">{{ apConf }}<\u002Fspan><\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"display:flex;gap:10px\">\n            <button sc-camel-on-click=\"{{ denyFire }}\" style=\"flex:1;padding:13px;border-radius:11px;border:1px solid #e2e8f2;background:#fff;color:#48566a;font-family:'Prompt',sans-serif;font-size:13.5px;font-weight:600;cursor:pointer\" style-hover=\"color:#dc2626;border-color:#fca5a5\">ไม่ใช่เหตุเพลิงไหม้<\u002Fbutton>\n            <button sc-camel-on-click=\"{{ approveFire }}\" style=\"flex:1.4;padding:13px;border-radius:11px;border:none;background:#dc2626;color:#fff;font-family:'Prompt',sans-serif;font-size:14px;font-weight:700;cursor:pointer;box-shadow:0 6px 18px rgba(220,38,38,.34)\">อนุมัติ · ส่งหุ่นยนต์<\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ pairOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"position:fixed;inset:0;z-index:210;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(12,20,33,.5);backdrop-filter:blur(3px);animation:pcRise .2s ease\">\n      <div style=\"width:100%;max-width:660px;background:#fff;border-radius:20px;box-shadow:0 30px 70px rgba(12,20,33,.35);display:flex;flex-direction:column;overflow:hidden\">\n        <div style=\"display:flex;align-items:center;gap:12px;padding:20px 24px;border-bottom:1px solid #eef2f7\">\n          <div>\n            <div style=\"font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:2px;color:#2563eb;font-weight:600\">PAIR NEW ROBOT<\u002Fdiv>\n            <div style=\"font-size:19px;font-weight:600;letter-spacing:-.3px;margin-top:2px\">เชื่อมต่อหุ่นยนต์ใหม่<\u002Fdiv>\n          <\u002Fdiv>\n          <button sc-camel-on-click=\"{{ pairClose }}\" style=\"margin-left:auto;width:34px;height:34px;border-radius:10px;border:1px solid #e6ebf2;background:#fff;color:#94a3b8;font-size:15px;cursor:pointer;line-height:1\" style-hover=\"color:#dc2626;border-color:#fca5a5\">✕<\u002Fbutton>\n        <\u002Fdiv>\n\n        <div style=\"display:grid;grid-template-columns:250px minmax(0,1fr)\">\n          <div style=\"padding:16px;border-right:1px solid #eef2f7;background:#fbfbfa;display:flex;flex-direction:column;gap:2px\">\n            <sc-for list=\"{{ pairSteps }}\" as=\"p\" hint-placeholder-count=\"4\">\n              <div style=\"{{ p.row }}\">\n                <div style=\"{{ p.dot }}\">{{ p.num }}<\u002Fdiv>\n                <div>\n                  <div style=\"{{ p.titleStyle }}\">{{ p.title }}<\u002Fdiv>\n                  <div style=\"{{ p.descStyle }}\">{{ p.desc }}<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n\n          <div style=\"padding:22px 24px;display:flex;flex-direction:column;align-items:center;gap:15px;min-height:300px;justify-content:center\">\n            <sc-if value=\"{{ pairIs0 }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"display:flex;flex-direction:column;align-items:center;gap:14px;width:100%\">\n                <div style=\"display:flex;align-items:center;gap:13px;width:100%;padding:15px 16px;border-radius:13px;background:#e7f8f0;border:1px solid rgba(16,185,129,.28)\">\n                  <svg width=\"24\" height=\"24\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#047857\" stroke-width=\"1.9\" stroke-linecap=\"round\"><path d=\"M5 12.55a11 11 0 0 1 14 0M2 8.82a16 16 0 0 1 20 0M8.5 16.43a6 6 0 0 1 7 0M12 20h.01\"><\u002Fpath><\u002Fsvg>\n                  <div>\n                    <div style=\"font-size:13.5px;font-weight:600;color:#047857\">เชื่อมต่อกับ {{ ssid }} แล้ว<\u002Fdiv>\n                    <div style=\"font-family:'IBM Plex Mono',monospace;font-size:11px;color:#3f9a78\">gateway 192.168.4.1 · ทุกหน่วยอยู่ในเครือข่ายเดียวกัน<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n                <p style=\"font-size:12.5px;color:#8494a8;line-height:1.7;text-align:center;max-width:340px;text-wrap:pretty\">เปิดสวิตช์หุ่นยนต์แล้วรอให้ Raspberry Pi กระจายสัญญาณ จากนั้นกดปุ่มด้านล่างเพื่อให้เว็บขอสิทธิ์ใช้กล้องสำหรับสแกน QR บนตัวเครื่อง<\u002Fp>\n                <button sc-camel-on-click=\"{{ openCam }}\" style=\"padding:12px 24px;border-radius:11px;border:none;background:#2563eb;color:#fff;font-family:'Prompt',sans-serif;font-size:14px;font-weight:600;cursor:pointer;box-shadow:0 5px 14px rgba(37,99,235,.28)\">สแกนเพื่อเชื่อมต่อหุ่นยนต์<\u002Fbutton>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ pairIs1 }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"display:flex;flex-direction:column;align-items:center;gap:14px;max-width:400px\">\n                <svg width=\"40\" height=\"40\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z\"><\u002Fpath><circle cx=\"12\" cy=\"13\" r=\"4\"><\u002Fcircle><\u002Fsvg>\n                <div style=\"font-size:15px;font-weight:600;text-align:center\">อนุญาตให้ใช้กล้อง<\u002Fdiv>\n                <p style=\"font-size:12.5px;color:#8494a8;line-height:1.7;text-align:center;text-wrap:pretty\">เว็บแอปต้องใช้กล้องหลังของอุปกรณ์เพื่ออ่าน QR บนตัวหุ่นยนต์ ข้อมูลภาพไม่ถูกส่งออกนอกเครือข่าย<\u002Fp>\n                <button sc-camel-on-click=\"{{ startScan }}\" style=\"padding:12px 24px;border-radius:11px;border:none;background:#2563eb;color:#fff;font-family:'Prompt',sans-serif;font-size:14px;font-weight:600;cursor:pointer;box-shadow:0 5px 14px rgba(37,99,235,.28)\">อนุญาตและเปิดกล้อง<\u002Fbutton>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ pairIs2 }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"display:flex;flex-direction:column;align-items:center;gap:14px\">\n                <div style=\"{{ scanFrame }}\">\n                  <div style=\"{{ qrGrid }}\">\n                    <sc-for list=\"{{ qrCells }}\" as=\"q\" hint-placeholder-count=\"0\">\n                      <div style=\"{{ q.style }}\"><\u002Fdiv>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                  <div style=\"{{ scanLine }}\"><\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"font-family:'IBM Plex Mono',monospace;font-size:12px;color:#2563eb\">กำลังอ่าน QR · เล็งกล้องไปที่รหัสบนตัวเครื่อง<\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ pairIs3 }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"width:100%;display:flex;flex-direction:column;gap:13px\">\n                <div style=\"font-size:15px;font-weight:600\">อ่าน QR สำเร็จ<\u002Fdiv>\n                <div style=\"font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#0369a1;background:#e6f5fd;border:1px solid rgba(14,165,233,.25);border-radius:9px;padding:9px 12px;word-break:break-all\">{{ pairPayload }}<\u002Fdiv>\n                <div style=\"display:flex;flex-direction:column;gap:8px;padding:15px 16px;border-radius:13px;background:#f6f8fb;border:1px solid #e6ebf2\">\n                  <div style=\"display:flex;align-items:center;gap:10px\"><span style=\"font-size:12.5px;color:#8494a8;width:104px;flex:none\">Robot ID<\u002Fspan><span style=\"font-family:'IBM Plex Mono',monospace;font-size:13px;font-weight:600\">{{ pairId }}<\u002Fspan><\u002Fdiv>\n                  <div style=\"display:flex;align-items:center;gap:10px\"><span style=\"font-size:12.5px;color:#8494a8;width:104px;flex:none\">rosbridge<\u002Fspan><span style=\"font-family:'IBM Plex Mono',monospace;font-size:13px;font-weight:600\">{{ pairEndpoint }}<\u002Fspan><\u002Fdiv>\n                  <div style=\"display:flex;align-items:center;gap:10px\"><span style=\"font-size:12.5px;color:#8494a8;width:104px;flex:none\">หมายเลขเครื่อง<\u002Fspan><span style=\"font-family:'IBM Plex Mono',monospace;font-size:13px\">{{ pairSerial }}<\u002Fspan><\u002Fdiv>\n                  <div style=\"display:flex;align-items:center;gap:10px\"><span style=\"font-size:12.5px;color:#8494a8;width:104px;flex:none\">รุ่น · เฟิร์มแวร์<\u002Fspan><span style=\"font-size:13px;font-weight:600\">{{ pairModel }} · {{ pairFw }}<\u002Fspan><\u002Fdiv>\n                  <div style=\"display:flex;align-items:center;gap:10px\"><span style=\"font-size:12.5px;color:#8494a8;width:104px;flex:none\">ชื่อในระบบ<\u002Fspan><span style=\"font-size:13px;font-weight:600\">{{ pairName }} · {{ pairAgent }}<\u002Fspan><\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"display:flex;gap:9px\">\n                  <button sc-camel-on-click=\"{{ startScan }}\" style=\"padding:11px 18px;border-radius:10px;border:1px solid #e2e8f2;background:#fff;color:#48566a;font-family:'Prompt',sans-serif;font-size:13.5px;font-weight:600;cursor:pointer\">สแกนใหม่<\u002Fbutton>\n                  <button sc-camel-on-click=\"{{ confirmPair }}\" style=\"margin-left:auto;padding:11px 22px;border-radius:10px;border:none;background:#2563eb;color:#fff;font-family:'Prompt',sans-serif;font-size:13.5px;font-weight:600;cursor:pointer;box-shadow:0 5px 14px rgba(37,99,235,.28)\">เชื่อมต่อ rosbridge<\u002Fbutton>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ pairIs4 }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"display:flex;flex-direction:column;align-items:center;gap:13px\">\n                <div style=\"width:52px;height:52px;border-radius:50%;border:3px solid #dbe2ec;border-top-color:#2563eb;animation:pcSpin .8s linear infinite\"><\u002Fdiv>\n                <div style=\"font-size:14px;font-weight:600\">กำลังเชื่อมต่อ roslibjs…<\u002Fdiv>\n                <div style=\"font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#94a3b8\">{{ pairEndpoint }}<\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ wizOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(12,20,33,.5);backdrop-filter:blur(3px);animation:pcRise .2s ease\">\n      <div style=\"width:100%;max-width:760px;max-height:88vh;overflow:auto;background:#fff;border-radius:20px;box-shadow:0 30px 70px rgba(12,20,33,.35);display:flex;flex-direction:column\">\n\n        <div style=\"display:flex;align-items:center;gap:12px;padding:20px 24px;border-bottom:1px solid #eef2f7\">\n          <div>\n            <div style=\"font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:2px;color:#2563eb;font-weight:600\">SETUP WIZARD<\u002Fdiv>\n            <div style=\"font-size:19px;font-weight:600;letter-spacing:-.3px;margin-top:2px\">ตั้งค่าอาคารใหม่<\u002Fdiv>\n          <\u002Fdiv>\n          <span style=\"margin-left:auto;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#94a3b8\">{{ wizCounter }}<\u002Fspan>\n          <button sc-camel-on-click=\"{{ wizClose }}\" style=\"width:34px;height:34px;border-radius:10px;border:1px solid #e6ebf2;background:#fff;color:#94a3b8;font-size:15px;cursor:pointer;line-height:1\" style-hover=\"color:#dc2626;border-color:#fca5a5\">✕<\u002Fbutton>\n        <\u002Fdiv>\n\n        <div style=\"display:grid;grid-template-columns:266px minmax(0,1fr);gap:0;flex:1;min-height:0\">\n          <div style=\"padding:16px;border-right:1px solid #eef2f7;background:#fbfbfa;display:flex;flex-direction:column;gap:2px\">\n            <sc-for list=\"{{ wizSteps }}\" as=\"s\" hint-placeholder-count=\"4\">\n              <div style=\"{{ s.row }}\">\n                <div style=\"{{ s.dot }}\">{{ s.num }}<\u002Fdiv>\n                <div>\n                  <div style=\"{{ s.titleStyle }}\">{{ s.title }}<\u002Fdiv>\n                  <div style=\"{{ s.descStyle }}\">{{ s.desc }}<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n\n          <div style=\"padding:22px 24px;display:flex;flex-direction:column;gap:14px\">\n            <sc-if value=\"{{ wizIs0 }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"display:flex;flex-direction:column;gap:9px\">\n                <div style=\"font-size:15px;font-weight:600\">ชื่ออาคาร<\u002Fdiv>\n                <p style=\"font-size:12.5px;color:#8494a8;line-height:1.6;text-wrap:pretty\">ใช้ชื่อที่เจ้าหน้าที่เรียกจริง เช่น “อาคาร C · คลังสินค้า” เพื่อให้สื่อสารทางวิทยุได้ตรงกัน<\u002Fp>\n                <input value=\"{{ wizName }}\" sc-camel-on-change=\"{{ onWizName }}\" placeholder=\"เช่น อาคาร C · คลังสินค้า\" style=\"{{ wizInput }}\">\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ wizIs1 }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"display:flex;flex-direction:column;gap:10px\">\n                <div style=\"font-size:15px;font-weight:600\">จะสร้างแผนผังด้วยวิธีไหน<\u002Fdiv>\n                <sc-for list=\"{{ methodCards }}\" as=\"m\" hint-placeholder-count=\"2\">\n                  <button sc-camel-on-click=\"{{ m.onClick }}\" style=\"{{ m.card }}\">\n                    <div style=\"{{ m.titleStyle }}\">{{ m.title }}<\u002Fdiv>\n                    <div style=\"{{ m.descStyle }}\">{{ m.desc }}<\u002Fdiv>\n                  <\u002Fbutton>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ wizIsUpload }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"display:flex;flex-direction:column;gap:11px\">\n                <div style=\"font-size:15px;font-weight:600\">อัปโหลดไฟล์แผนผัง<\u002Fdiv>\n                <p style=\"font-size:12.5px;color:#8494a8;line-height:1.6;text-wrap:pretty\">เลือกไฟล์ occupancy grid (.pgm) ที่ export จาก SLAM หรือภาพแปลนพื้น (.png / .jpg) — ระบบจะย่อขนาดให้อัตโนมัติ<\u002Fp>\n                <div style=\"display:flex;align-items:center;gap:10px\">\n                  <button sc-camel-on-click=\"{{ wizPickFile }}\" style=\"padding:11px 18px;border-radius:10px;border:1px dashed #cbd5e1;background:#f6f8fb;color:#48566a;font-family:'Prompt',sans-serif;font-size:13.5px;font-weight:600;cursor:pointer\">เลือกไฟล์…<\u002Fbutton>\n                  <span style=\"font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#94a3b8\">{{ wizPlanName }}<\u002Fspan>\n                  <input ref=\"{{ wizFileRef }}\" type=\"file\" accept=\".pgm,image/*\" sc-camel-on-change=\"{{ onWizFile }}\" style=\"{{ planFileInput }}\">\n                <\u002Fdiv>\n                <div style=\"{{ wizPreview }}\"><\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ wizIsScan }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"display:flex;flex-direction:column;gap:11px\">\n                <div style=\"display:flex;align-items:center;gap:10px\">\n                  <span style=\"font-size:15px;font-weight:600\">ขับหุ่นยนต์สำรวจพื้นที่<\u002Fspan>\n                  <span style=\"margin-left:auto;font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#2563eb;font-weight:600\">สำรวจแล้ว {{ scanPct }}%<\u002Fspan>\n                <\u002Fdiv>\n                <div style=\"position:relative;width:100%;height:214px;border-radius:12px;overflow:hidden;background:#e2e8f0;border:1px solid #cbd5e1\">\n                  <sc-for list=\"{{ scanGrid }}\" as=\"c\" hint-placeholder-count=\"0\">\n                    <div style=\"{{ c.style }}\"><\u002Fdiv>\n                  <\u002Fsc-for>\n                  <div style=\"{{ scanBotStyle }}\"><\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"display:flex;align-items:center;gap:16px\">\n                  <div style=\"display:grid;grid-template-columns:repeat(3,46px);gap:5px\">\n                    <span><\u002Fspan>\n                    <button sc-camel-on-click=\"{{ padUp }}\" style=\"{{ padBtn }}\">↑<\u002Fbutton>\n                    <span><\u002Fspan>\n                    <button sc-camel-on-click=\"{{ padLeft }}\" style=\"{{ padBtn }}\">←<\u002Fbutton>\n                    <button sc-camel-on-click=\"{{ padDown }}\" style=\"{{ padBtn }}\">↓<\u002Fbutton>\n                    <button sc-camel-on-click=\"{{ padRight }}\" style=\"{{ padBtn }}\">→<\u002Fbutton>\n                  <\u002Fdiv>\n                  <div style=\"flex:1;min-width:0\">\n                    <p style=\"font-size:12px;color:#8494a8;line-height:1.6;text-wrap:pretty\">ขับให้ครอบคลุมพื้นที่ทั้งหมด — พื้นที่สีเข้มคือส่วนที่ LiDAR ยังไม่เห็น เมื่อพอใจแล้วกดถัดไปเพื่อแบ่งโซน<\u002Fp>\n                    <button sc-camel-on-click=\"{{ scanReset }}\" style=\"margin-top:8px;padding:8px 14px;border-radius:9px;border:1px solid #e2e8f2;background:#fff;color:#94a3b8;font-family:'Prompt',sans-serif;font-size:12.5px;font-weight:600;cursor:pointer\">เริ่มสแกนใหม่<\u002Fbutton>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ wizIs3 }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"display:flex;flex-direction:column;gap:11px\">\n                <div style=\"font-size:15px;font-weight:600\">เพิ่มโซนในอาคาร<\u002Fdiv>\n                <p style=\"font-size:12.5px;color:#8494a8;line-height:1.6;text-wrap:pretty\">แบ่งอาคารเป็นโซนย่อยตามพื้นที่ที่ต้องเฝ้าระวัง อย่างน้อย 1 โซน — ปรับตำแหน่งบนผังได้ภายหลัง<\u002Fp>\n                <div style=\"display:flex;gap:8px\">\n                  <input value=\"{{ wizDraft }}\" sc-camel-on-change=\"{{ onWizDraft }}\" placeholder=\"ชื่อโซน เช่น โซน B\" style=\"{{ wizInput }}\">\n                  <button sc-camel-on-click=\"{{ wizAddZone }}\" style=\"padding:11px 18px;border-radius:10px;border:none;background:#0e1726;color:#fff;font-family:'Prompt',sans-serif;font-size:13.5px;font-weight:600;cursor:pointer\">เพิ่ม<\u002Fbutton>\n                <\u002Fdiv>\n                <div style=\"display:flex;flex-direction:column;gap:7px\">\n                  <sc-for list=\"{{ wizZoneList }}\" as=\"z\" hint-placeholder-count=\"1\">\n                    <div style=\"display:flex;align-items:center;gap:10px;padding:11px 13px;border-radius:10px;background:#f6f8fb;border:1px solid #e6ebf2\">\n                      <span style=\"font-size:13.5px;font-weight:600\">{{ z.name }}<\u002Fspan>\n                      <span style=\"font-size:12px;color:#8494a8\">{{ z.type }}<\u002Fspan>\n                      <button sc-camel-on-click=\"{{ z.onRemove }}\" style=\"margin-left:auto;width:28px;height:28px;border-radius:8px;border:1px solid #e6ebf2;background:#fff;color:#94a3b8;cursor:pointer;line-height:1\" style-hover=\"color:#dc2626;border-color:#fca5a5\">✕<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ wizIs4 }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"display:flex;flex-direction:column;gap:11px\">\n                <div style=\"font-size:15px;font-weight:600\">ชนิดพื้นที่ของแต่ละโซน<\u002Fdiv>\n                <p style=\"font-size:12.5px;color:#8494a8;line-height:1.6;text-wrap:pretty\">ระบบเลือกสารดับให้อัตโนมัติ — ห้องไฟฟ้า/เซิร์ฟเวอร์ใช้ CO₂, ครัวและสารเคมีใช้ Foam, พื้นที่ทั่วไปใช้ Water<\u002Fp>\n                <div style=\"display:flex;flex-direction:column;gap:8px\">\n                  <sc-for list=\"{{ wizZoneList }}\" as=\"z\" hint-placeholder-count=\"2\">\n                    <div style=\"display:flex;align-items:center;gap:10px\">\n                      <span style=\"font-size:13.5px;font-weight:600;width:84px;flex:none\">{{ z.name }}<\u002Fspan>\n                      <input value=\"{{ z.type }}\" sc-camel-on-change=\"{{ z.onType }}\" style=\"{{ z.typeInput }}\">\n                      <span style=\"{{ z.agentPill }}\">{{ z.agent }}<\u002Fspan>\n                    <\u002Fdiv>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ wizIs5 }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"display:flex;flex-direction:column;gap:11px\">\n                <div style=\"font-size:15px;font-weight:600\">มอบหมายหุ่นยนต์ลาดตระเวน<\u002Fdiv>\n                <p style=\"font-size:12.5px;color:#8494a8;line-height:1.6;text-wrap:pretty\">เลือกหุ่นยนต์ประจำแต่ละโซน ข้ามได้ถ้ายังไม่กำหนด — เมื่อสร้างเสร็จ ระบบจะพาไปวาดกำแพงบนผังต่อ<\u002Fp>\n                <div style=\"display:flex;flex-direction:column;gap:8px\">\n                  <sc-for list=\"{{ wizZoneList }}\" as=\"z\" hint-placeholder-count=\"2\">\n                    <div style=\"display:flex;align-items:center;gap:10px\">\n                      <span style=\"font-size:13.5px;font-weight:600;width:84px;flex:none\">{{ z.name }}<\u002Fspan>\n                      <span style=\"{{ z.agentPill }}\">{{ z.agent }}<\u002Fspan>\n                      <div style=\"margin-left:auto;display:flex;gap:6px\">\n                        <sc-for list=\"{{ z.robotBtns }}\" as=\"r\" hint-placeholder-count=\"3\">\n                          <button sc-camel-on-click=\"{{ r.onClick }}\" style=\"{{ r.style }}\">{{ r.label }}<\u002Fbutton>\n                        <\u002Fsc-for>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <div style=\"display:flex;align-items:center;gap:10px;padding:16px 24px;border-top:1px solid #eef2f7;background:#fbfbfa;border-radius:0 0 20px 20px\">\n          <button sc-camel-on-click=\"{{ wizBack }}\" style=\"{{ wizBackStyle }}\">ย้อนกลับ<\u002Fbutton>\n          <button sc-camel-on-click=\"{{ wizNext }}\" style=\"{{ wizNextStyle }}\">{{ wizNextLabel }}<\u002Fbutton>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n<\u002Fdiv>\n\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;fusionThreshold&quot;:{&quot;editor&quot;:&quot;int&quot;,&quot;default&quot;:2,&quot;min&quot;:1,&quot;max&quot;:4,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Detection&quot;},&quot;showTrends&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Display&quot;}}\">\nclass Component extends DCLogic {\n  constructor(p){\n    super(p);\n    this.bRef = React.createRef();\n    this.zRef = React.createRef();\n    this.planRef = React.createRef();\n    this.wizFileRef = React.createRef();\n    this.tRef = React.createRef();\n    this.mapRef = React.createRef();\n    this.t0 = Date.now();\n    const buildings = [\n      {id:'B1', name:'อาคาร A · Main', zones:[\n        {id:'A', name:'โซน A', type:'สำนักงาน'},\n        {id:'B', name:'โซน B', type:'ห้องเซิร์ฟเวอร์'},\n        {id:'C', name:'โซน C', type:'โรงครัว'},\n        {id:'D', name:'โซน D', type:'คลังสินค้า'}]},\n      {id:'B2', name:'อาคาร B · Lab', zones:[\n        {id:'E', name:'โซน E', type:'ห้องแล็บ'},\n        {id:'F', name:'โซน F', type:'ห้องเก็บสารเคมี'}]}\n    ];\n    const sensors = {};\n    buildings.forEach(b=>b.zones.forEach(z=>{ sensors[z.id] = this.baseline(); }));\n    this.state = {\n      page:'live', clock:'--:--:--', uptime:'00:00',\n      buildings, bld:'B1', sensors,\n      robots:[\n        {id:'R1', name:'Guardian-01', short:'R1', color:'#2563eb', agent:'CO₂', x:26, y:26, tx:26, ty:26, state:'patrol', bat:96},\n        {id:'R2', name:'Guardian-02', short:'R2', color:'#0ea5e9', agent:'Foam', x:74, y:26, tx:74, ty:26, state:'patrol', bat:88},\n        {id:'R3', name:'Guardian-03', short:'R3', color:'#1e3a8a', agent:'Water', x:26, y:74, tx:26, ty:74, state:'patrol', bat:73}\n      ],\n      assign:{R1:['A','B'], R2:['C'], R3:['D']},\n      fire:null, phase:'', fireT:0, phaseT:0, responder:null, lastSecs:9, lastZone:'—',\n      events:[], selRobot:'R1', simZone:'A',\n      addBld:false, saved:false, mode:'auto', lidarSeed:1, editMap:false, dragging:null, siteName:'ห้องควบคุม', tool:'select', draft:null, loading:false, loadMsg:'', loadPct:0, wiz:false, wizStep:0, wizName:'', wizZones:[], wizAssign:{}, wizDraft:'',\n      vw: typeof window !== 'undefined' ? window.innerWidth : 1440\n    };\n  }\n\n  baseline(){\n    const t = 26.5 + Math.random();\n    return {temp:t, smoke:170+Math.random()*20, flame:.02, co:8+Math.random()*3, hist:Array.from({length:24},()=>t+(Math.random()-.5)*.8)};\n  }\n\n  componentDidMount(){\n    this.timer = setInterval(()=>this.tick(), 1000);\n    this.onResize = ()=>{\n      const w = window.innerWidth;\n      if (w !== this.state.vw) this.setState({vw:w});\n    };\n    window.addEventListener('resize', this.onResize);\n    this.onResize();\n    this.loadSaved();\n    this.seedEvents();\n    this.tick();\n  }\n  componentWillUnmount(){\n    clearInterval(this.timer); clearInterval(this.loadI); clearTimeout(this.loadT); clearTimeout(this.saveT);\n    clearTimeout(this.pairT1); clearTimeout(this.pairT2);\n    window.removeEventListener('resize', this.onResize);\n  }\n\n  geo(zones){\n    const n = zones.length || 1;\n    const cols = Math.ceil(Math.sqrt(n));\n    const rows = Math.ceil(n/cols);\n    const pad = 2.6, m = {};\n    zones.forEach((z,i)=>{\n      const c = i%cols, r = Math.floor(i/cols);\n      const cw = 100/cols, ch = 100/rows;\n      const a = {l:c*cw+pad, t:r*ch+pad, w:cw-pad*2, h:ch-pad*2};\n      const g = z.geom || a;\n      m[z.id] = {l:g.l, t:g.t, w:g.w, h:g.h, cx:g.l+g.w/2, cy:g.t+g.h/2};\n    });\n    return m;\n  }\n\n  patchZone(zid, patch){\n    this.setState(s=>({\n      buildings: s.buildings.map(b=> b.id!==s.bld ? b : Object.assign({}, b, {\n        zones: b.zones.map(z=> z.id!==zid ? z : Object.assign({}, z, patch))\n      })), saved:false\n    }));\n  }\n\n  deleteZone(zid){\n    this.setState(s=>{\n      const assign = {};\n      Object.keys(s.assign).forEach(k=>{ assign[k] = (s.assign[k]||[]).filter(z=>z!==zid); });\n      const buildings = s.buildings.map(b=> b.id!==s.bld ? b : Object.assign({}, b, {zones:b.zones.filter(z=>z.id!==zid)}));\n      const bb = buildings.find(b=>b.id===s.bld);\n      return {buildings, assign, saved:false,\n        fire: s.fire===zid ? null : s.fire, phase: s.fire===zid ? '' : s.phase,\n        simZone: s.simZone===zid ? (bb && bb.zones[0] ? bb.zones[0].id : null) : s.simZone};\n    });\n  }\n\n  deleteBuilding(bid){\n    this.setState(s=>{\n      if (s.buildings.length <= 1) return {};\n      const buildings = s.buildings.filter(b=>b.id!==bid);\n      const nb = buildings[0];\n      return {buildings, bld:nb.id, simZone: nb.zones[0] ? nb.zones[0].id : null,\n        fire:null, phase:'', fireT:0, saved:false};\n    });\n  }\n\n  uploadPlan(ev){\n    const f = ev.target.files && ev.target.files[0];\n    if (!f) return;\n    const rd = new FileReader();\n    rd.onload = e=>{\n      const img = new Image();\n      img.onload = ()=>{\n        const max = 1200;\n        const k = Math.min(1, max/Math.max(img.width, img.height));\n        const cv = document.createElement('canvas');\n        cv.width = Math.round(img.width*k); cv.height = Math.round(img.height*k);\n        cv.getContext('2d').drawImage(img, 0, 0, cv.width, cv.height);\n        let url;\n        try { url = cv.toDataURL('image/jpeg', 0.7); } catch(err){ url = e.target.result; }\n        this.setState(s=>({saved:false, showPlan:true,\n          buildings: s.buildings.map(b=> b.id!==s.bld ? b : Object.assign({}, b, {plan:url}))}));\n      };\n      img.src = e.target.result;\n    };\n    rd.readAsDataURL(f);\n    ev.target.value = '';\n  }\n\n  clearPlan(){\n    this.setState(s=>({saved:false,\n      buildings: s.buildings.map(b=> b.id!==s.bld ? b : Object.assign({}, b, {plan:null}))}));\n  }\n\n  autoArrange(){\n    this.setState(s=>({\n      buildings: s.buildings.map(b=> b.id!==s.bld ? b : Object.assign({}, b, {\n        zones: b.zones.map(z=>{ const c = Object.assign({}, z); delete c.geom; return c; })\n      })), saved:false\n    }));\n  }\n\n  mapPoint(e){\n    const host = this.mapRef && this.mapRef.current;\n    if (!host) return null;\n    const r = host.getBoundingClientRect();\n    const snap = v => Math.max(0, Math.min(100, Math.round(v/2)*2));\n    return {x:snap((e.clientX-r.left)/r.width*100), y:snap((e.clientY-r.top)/r.height*100)};\n  }\n\n  openWizard(){\n    this.setState({wiz:true, wizStep:0, wizName:'', wizZones:[{name:'โซน A', type:'สำนักงาน'}], wizAssign:{}, wizDraft:'',\n      wizMethod:null, wizPlan:null, scanCells:{}, scanBot:{x:50, y:78, dir:'up'}});\n  }\n\n  scanMove(dir){\n    const step = 4.2;\n    this.setState(s=>{\n      const b = s.scanBot;\n      let x = b.x, y = b.y;\n      if (dir === 'up') y -= step;\n      if (dir === 'down') y += step;\n      if (dir === 'left') x -= step;\n      if (dir === 'right') x += step;\n      x = Math.max(3, Math.min(97, x));\n      y = Math.max(3, Math.min(97, y));\n      const cells = Object.assign({}, s.scanCells);\n      const COLS = 20, ROWS = 14, R = 13;\n      for (let c = 0; c < COLS; c++){\n        for (let r = 0; r < ROWS; r++){\n          const cx = (c+0.5)*(100/COLS), cy = (r+0.5)*(100/ROWS);\n          if (Math.hypot(cx-x, (cy-y)*0.72) <= R) cells[c+'_'+r] = 1;\n        }\n      }\n      return {scanBot:{x, y, dir}, scanCells:cells};\n    });\n  }\n\n  scanReset(){ this.setState({scanCells:{}, scanBot:{x:50, y:78, dir:'up'}, wizPlan:null}); }\n\n  scanToDataUrl(){\n    try {\n      const COLS = 20, ROWS = 14, S = 40;\n      const cv = document.createElement('canvas');\n      cv.width = COLS*S; cv.height = ROWS*S;\n      const ctx = cv.getContext('2d');\n      ctx.fillStyle = '#b8c2cf'; ctx.fillRect(0, 0, cv.width, cv.height);\n      ctx.fillStyle = '#ffffff';\n      const cells = this.state.scanCells || {};\n      for (let c = 0; c < COLS; c++) for (let r = 0; r < ROWS; r++){\n        if (cells[c+'_'+r]) ctx.fillRect(c*S, r*S, S, S);\n      }\n      ctx.strokeStyle = '#334155'; ctx.lineWidth = 6;\n      ctx.strokeRect(3, 3, cv.width-6, cv.height-6);\n      return cv.toDataURL('image/png');\n    } catch(e){ return null; }\n  }\n\n  wizUpload(ev){\n    const f = ev.target.files && ev.target.files[0];\n    if (!f) return;\n    const isPgm = /\\.pgm$/i.test(f.name);\n    const rd = new FileReader();\n    rd.onload = e=>{\n      if (isPgm){ this.setState({wizPlan:this.pgmToDataUrl(e.target.result), wizPlanName:f.name}); return; }\n      const img = new Image();\n      img.onload = ()=>{\n        const max = 1200, k = Math.min(1, max/Math.max(img.width, img.height));\n        const cv = document.createElement('canvas');\n        cv.width = Math.round(img.width*k); cv.height = Math.round(img.height*k);\n        cv.getContext('2d').drawImage(img, 0, 0, cv.width, cv.height);\n        let url; try { url = cv.toDataURL('image/jpeg', 0.7); } catch(err){ url = e.target.result; }\n        this.setState({wizPlan:url, wizPlanName:f.name});\n      };\n      img.src = e.target.result;\n    };\n    if (isPgm) rd.readAsArrayBuffer(f); else rd.readAsDataURL(f);\n  }\n\n  pgmToDataUrl(buf){\n    try {\n      const bytes = new Uint8Array(buf);\n      let p = 0;\n      const token = ()=>{\n        while (p < bytes.length && /\\s/.test(String.fromCharCode(bytes[p]))) p++;\n        if (String.fromCharCode(bytes[p]) === '#'){ while (bytes[p] !== 10) p++; return token(); }\n        let t = '';\n        while (p < bytes.length && !/\\s/.test(String.fromCharCode(bytes[p]))) t += String.fromCharCode(bytes[p++]);\n        return t;\n      };\n      const magic = token(), w = +token(), h = +token(), maxv = +token();\n      p++;\n      const cv = document.createElement('canvas');\n      cv.width = w; cv.height = h;\n      const ctx = cv.getContext('2d');\n      const im = ctx.createImageData(w, h);\n      for (let i = 0; i < w*h; i++){\n        let v;\n        if (magic === 'P5') v = bytes[p+i]/maxv*255;\n        else v = 128;\n        im.data[i*4] = im.data[i*4+1] = im.data[i*4+2] = v;\n        im.data[i*4+3] = 255;\n      }\n      ctx.putImageData(im, 0, 0);\n      return cv.toDataURL('image/png');\n    } catch(e){ return null; }\n  }\n  closeWizard(){ this.setState({wiz:false}); }\n  wizNext(){\n    const s = this.state;\n    if (s.wizStep === 0 && !s.wizName.trim()) return;\n    if (s.wizStep === 1 && !s.wizMethod) return;\n    if (s.wizStep === 3 && !s.wizZones.length) return;\n    if (s.wizStep === 2 && s.wizMethod === 'scan' && !s.wizPlan){\n      const url = this.scanToDataUrl();\n      if (url) this.setState({wizPlan:url, wizPlanName:'slam_map.png'});\n    }\n    if (s.wizStep >= 5){ this.commitWizard(); return; }\n    this.setState({wizStep:s.wizStep+1});\n  }\n  wizBack(){ this.setState(s=>({wizStep:Math.max(0, s.wizStep-1)})); }\n  wizAddZone(){\n    const v = (this.state.wizDraft||'').trim();\n    if (!v) return;\n    this.setState(s=>({wizZones:s.wizZones.concat([{name:v, type:'พื้นที่ทั่วไป'}]), wizDraft:''}));\n  }\n  commitWizard(){\n    this.setState(s=>{\n      const bid = 'B'+Date.now().toString(36).slice(-4);\n      const zones = s.wizZones.map((z,i)=>({id:'Z'+Date.now().toString(36).slice(-3).toUpperCase()+i, name:z.name, type:z.type}));\n      const sensors = Object.assign({}, s.sensors);\n      zones.forEach(z=>{ sensors[z.id] = this.baseline(); });\n      const assign = {};\n      Object.keys(s.assign).forEach(k=>{ assign[k] = (s.assign[k]||[]).slice(); });\n      zones.forEach((z,i)=>{\n        const rid = s.wizAssign[i];\n        if (rid && assign[rid]) assign[rid] = assign[rid].concat([z.id]);\n        else if (rid) assign[rid] = [z.id];\n      });\n      return {\n        buildings: s.buildings.concat([{id:bid, name:s.wizName.trim(), zones, walls:[], plan:s.wizPlan || null}]),\n        sensors, assign, bld:bid, simZone:zones[0].id, wiz:false, editMap:true, tool:'select',\n        showPlan:true, saved:false\n      };\n    });\n  }\n\n  addZoneAt(ev){\n    const p = this.mapPoint(ev);\n    if (!p) return;\n    const id = 'Z' + Date.now().toString(36).slice(-4).toUpperCase();\n    const w = 26, h = 24;\n    const geom = {l:Math.max(0, Math.min(100-w, p.x-w/2)), t:Math.max(0, Math.min(100-h, p.y-h/2)), w, h};\n    this.setState(s=>{\n      const b = this.curBld(s);\n      const n = b.zones.length + 1;\n      const zone = {id, name:'โซน '+String.fromCharCode(64+n), type:'พื้นที่ทั่วไป', geom};\n      return {\n        buildings: s.buildings.map(x=> x.id!==s.bld ? x : Object.assign({}, x, {zones:x.zones.concat([zone])})),\n        sensors: Object.assign({}, s.sensors, {[id]:this.baseline()}),\n        tool:'select', saved:false\n      };\n    });\n  }\n\n  startWall(ev){\n    if (!this.state.editMap) return;\n    if (this.state.tool === 'zone'){ ev.preventDefault(); this.addZoneAt(ev); return; }\n    ev.preventDefault();\n    const p = this.mapPoint(ev);\n    if (!p) return;\n    this.setState({draft:{x1:p.x, y1:p.y, x2:p.x, y2:p.y}});\n    const move = e => {\n      const q = this.mapPoint(e);\n      if (!q) return;\n      this.setState(s=>{\n        if (!s.draft) return {};\n        let {x2,y2} = {x2:q.x, y2:q.y};\n        if (e.shiftKey || Math.abs(q.x-s.draft.x1) < 3) x2 = Math.abs(q.x-s.draft.x1) < Math.abs(q.y-s.draft.y1) ? s.draft.x1 : q.x;\n        if (Math.abs(q.y-s.draft.y1) < 3) y2 = s.draft.y1;\n        return {draft:Object.assign({}, s.draft, {x2, y2})};\n      });\n    };\n    const up = ()=>{\n      window.removeEventListener('pointermove', move);\n      window.removeEventListener('pointerup', up);\n      this.setState(s=>{\n        const d = s.draft;\n        if (!d) return {draft:null};\n        const len = Math.hypot(d.x2-d.x1, d.y2-d.y1);\n        if (len < 3) return {draft:null};\n        return {draft:null, saved:false,\n          buildings: s.buildings.map(b=> b.id!==s.bld ? b : Object.assign({}, b, {walls:(b.walls||[]).concat([d])}))};\n      });\n    };\n    window.addEventListener('pointermove', move);\n    window.addEventListener('pointerup', up);\n  }\n\n  deleteWall(i){\n    this.setState(s=>({saved:false,\n      buildings: s.buildings.map(b=> b.id!==s.bld ? b : Object.assign({}, b, {walls:(b.walls||[]).filter((w,k)=>k!==i)}))}));\n  }\n\n  clearWalls(){\n    this.setState(s=>({saved:false,\n      buildings: s.buildings.map(b=> b.id!==s.bld ? b : Object.assign({}, b, {walls:[]}))}));\n  }\n\n  startDrag(zid, mode, ev){\n    ev.preventDefault();\n    ev.stopPropagation();\n    const host = this.mapRef && this.mapRef.current;\n    if (!host) return;\n    const rect = host.getBoundingClientRect();\n    const b = this.curBld(this.state);\n    const start = this.geo(b.zones)[zid];\n    const sx = ev.clientX, sy = ev.clientY;\n    const clamp = (v,min,max)=>Math.max(min, Math.min(max, v));\n    const move = e => {\n      const dx = (e.clientX-sx)/rect.width*100, dy = (e.clientY-sy)/rect.height*100;\n      let g;\n      if (mode === 'move'){\n        g = {l:clamp(start.l+dx, 0, 100-start.w), t:clamp(start.t+dy, 0, 100-start.h), w:start.w, h:start.h};\n      } else {\n        g = {l:start.l, t:start.t, w:clamp(start.w+dx, 12, 100-start.l), h:clamp(start.h+dy, 12, 100-start.t)};\n      }\n      g.l = Math.round(g.l*10)/10; g.t = Math.round(g.t*10)/10;\n      g.w = Math.round(g.w*10)/10; g.h = Math.round(g.h*10)/10;\n      this.patchZone(zid, {geom:g});\n    };\n    const up = ()=>{ window.removeEventListener('pointermove', move); window.removeEventListener('pointerup', up); this.setState({dragging:null}); };\n    window.addEventListener('pointermove', move);\n    window.addEventListener('pointerup', up);\n    this.setState({dragging:zid});\n  }\n\n  agentFor(type){\n    const t = String(type||'');\n    if (/เซิร์ฟเวอร์|ไฟฟ้า|แล็บ|คอม/.test(t)) return 'CO₂';\n    if (/ครัว|สารเคมี|น้ำมัน|เชื้อเพลิง/.test(t)) return 'Foam';\n    return 'Water';\n  }\n  agentColor(a){ return a==='CO₂' ? '#0ea5e9' : a==='Foam' ? '#d97706' : '#059669'; }\n  agentBg(a){ return a==='CO₂' ? '#e6f5fd' : a==='Foam' ? '#fef4e2' : '#e7f8f0'; }\n\n  curBld(s){ return s.buildings.find(b=>b.id===s.bld) || s.buildings[0]; }\n\n  seedEvents(){\n    const now = Date.now();\n    const at = secs => new Date(now - secs*1000).toLocaleTimeString('en-GB');\n    const seed = [\n      [360, 'D', 'done', 'ควบคุมเพลิงได้ · ใช้เวลารวม 11 วินาที'],\n      [365, 'D', 'spray', 'เริ่มฉีดสารดับ Water · nozzle 100%'],\n      [368, 'D', 'dispatch', 'ส่ง Guardian-03 เข้าพื้นที่ · agent Water'],\n      [371, 'D', 'detect', 'ตรวจพบความร้อน + ควันผิดปกติ · AI confirm 0.91'],\n      [2880, 'B', 'done', 'ควบคุมเพลิงได้ · ใช้เวลารวม 9 วินาที'],\n      [2884, 'B', 'spray', 'เริ่มฉีดสารดับ CO₂ · nozzle 100%'],\n      [2886, 'B', 'dispatch', 'ส่ง Guardian-01 เข้าพื้นที่ · agent CO₂'],\n      [2889, 'B', 'detect', 'อุณหภูมิพุ่ง 68°C ในห้องเซิร์ฟเวอร์ · fusion 3/4'],\n      [7920, 'C', 'done', 'ยกเลิกเหตุ · ควันจากการประกอบอาหาร ไม่ใช่เพลิงไหม้'],\n      [7962, 'C', 'detect', 'ตรวจพบควันในโรงครัว · รอ AI ยืนยัน'],\n      [12840, 'A', 'done', 'ซ้อมประจำเดือนเสร็จสิ้น · ทุกหน่วยกลับจุดประจำ'],\n      [12903, 'A', 'dispatch', 'ซ้อมดับเพลิง · ส่ง Guardian-02 เข้าพื้นที่']\n    ].map(e=>({time:at(e[0]), zone:e[1], tag:e[2], text:e[3]}));\n    this.setState(s=>{\n      if (s.events.length) return {};\n      const d = s.buildings[0] && s.buildings[0].zones.find(z=>z.id==='D');\n      return {events:seed, lastSecs:11, lastZone: d ? d.name : 'โซน D'};\n    });\n  }\n\n  addEvent(zone, tag, text){\n    const time = new Date().toLocaleTimeString('en-GB');\n    this.setState(s=>({events:[{time, zone, tag, text}, ...s.events].slice(0,60)}));\n  }\n\n  tick(){\n    this.setState(s=>{\n      const now = new Date();\n      const clock = now.toLocaleTimeString('en-GB');\n      const el = Math.floor((Date.now()-this.t0)/1000);\n      const uptime = String(Math.floor(el/60)).padStart(2,'0')+':'+String(el%60).padStart(2,'0');\n      const b = this.curBld(s);\n      const g = this.geo(b.zones);\n      const burningPhases = ['detect','dispatch','spray'];\n      const burning = s.fire && burningPhases.indexOf(s.phase) >= 0;\n\n      const sensors = Object.assign({}, s.sensors);\n      Object.keys(sensors).forEach(id=>{\n        const c = sensors[id];\n        const hot = burning && s.fire === id;\n        const ap = (v,target,jit)=> Math.max(0, v + (target-v)*0.3 + (Math.random()-.5)*jit);\n        const n = hot\n          ? {temp:ap(c.temp,79,2.2), smoke:ap(c.smoke,880,34), flame:ap(c.flame,.94,.03), co:ap(c.co,530,22)}\n          : {temp:ap(c.temp,27.2,.55), smoke:ap(c.smoke,176,13), flame:ap(c.flame,.03,.02), co:ap(c.co,9,2)};\n        n.hist = c.hist.concat([n.temp]).slice(-24);\n        sensors[id] = n;\n      });\n\n      let {fire, phase, fireT, phaseT, responder, lastSecs, lastZone} = s;\n      const events = [];\n      if (fire) { fireT++; phaseT++; }\n\n      const robots = s.robots.map(r=>{\n        const zoneIds = b.zones.map(z=>z.id);\n        const mine = (s.assign[r.id]||[]).filter(z=>zoneIds.indexOf(z)>=0);\n        const home = mine[0] || zoneIds[s.robots.indexOf(r) % zoneIds.length];\n        let {x,y,tx,ty,state,bat} = r;\n\n        if (state === 'charging'){\n          bat = Math.min(100, bat + 2.2);\n          if (bat >= (s.batFull != null ? s.batFull : 95)) state = 'patrol';\n        } else if (state === 'patrol'){\n          const hg = g[home];\n          if (hg && (Math.abs(x-tx) < 2.5 && Math.abs(y-ty) < 2.5 || tx == null)){\n            tx = hg.l + 8 + Math.random()*(hg.w-16);\n            ty = hg.t + 8 + Math.random()*(hg.h-16);\n          }\n          bat = Math.max(0, bat - .05);\n          if (bat < (s.batLow != null ? s.batLow : 18)) state = 'charging';\n        } else if (state === 'moving' || state === 'spraying'){\n          const fg = fire ? g[fire] : null;\n          if (fg){ tx = fg.cx; ty = fg.cy + 3; }\n          bat = Math.max(0, bat - (state==='spraying' ? .3 : .16));\n        } else if (state === 'returning'){\n          const hg = g[home];\n          if (hg){ tx = hg.cx; ty = hg.cy; }\n          bat = Math.max(0, bat - .06);\n          if (Math.abs(x-tx) < 3 && Math.abs(y-ty) < 3) state = 'patrol';\n        }\n\n        if (tx != null && state !== 'charging'){\n          const dx = tx-x, dy = ty-y;\n          const d = Math.sqrt(dx*dx+dy*dy);\n          const sp = state === 'moving' ? 11 : 5.5;\n          if (d > 0.4){ const k = Math.min(1, sp/d); x += dx*k; y += dy*k; }\n        }\n        return Object.assign({}, r, {x,y,tx,ty,state,bat});\n      });\n\n      const rIdx = id => robots.findIndex(r=>r.id===id);\n\n      if (fire){\n        const fz = b.zones.find(z=>z.id===fire);\n        const agent = fz ? this.agentFor(fz.type) : 'Water';\n        if (phase === 'detect' && phaseT >= 2 && s.mode === 'confirm' && !s.approved){\n          phaseT = 2;\n        } else if (phase === 'detect' && phaseT >= 2){\n          let pick = robots.filter(r=>r.state==='patrol' && r.agent===agent)[0]\n            || robots.filter(r=>r.state==='patrol')[0] || robots[0];\n          responder = pick.id;\n          robots[rIdx(responder)] = Object.assign({}, robots[rIdx(responder)], {state:'moving'});\n          phase = 'dispatch'; phaseT = 0;\n          events.push({zone:fire, tag:'dispatch', text:'ส่ง '+pick.name+' เข้าพื้นที่ · agent '+agent});\n        } else if (phase === 'dispatch' && responder != null){\n          const r = robots[rIdx(responder)];\n          const fg = g[fire];\n          if (fg && Math.abs(r.x-fg.cx) < 5 && Math.abs(r.y-(fg.cy+3)) < 5){\n            robots[rIdx(responder)] = Object.assign({}, r, {state:'spraying'});\n            phase = 'spray'; phaseT = 0;\n            events.push({zone:fire, tag:'spray', text:'เริ่มฉีดสารดับ '+agent+' · nozzle 100%'});\n          }\n        } else if (phase === 'spray' && phaseT >= 8){\n          robots[rIdx(responder)] = Object.assign({}, robots[rIdx(responder)], {state:'returning'});\n          events.push({zone:fire, tag:'done', text:'ควบคุมเพลิงได้ · ใช้เวลารวม '+fireT+' วินาที'});\n          lastSecs = fireT; lastZone = fz ? fz.name : fire;\n          phase = 'cooldown'; phaseT = 0;\n        } else if (phase === 'cooldown' && phaseT >= 4){\n          fire = null; phase = ''; fireT = 0; phaseT = 0; responder = null;\n        }\n      }\n\n      const time = now.toLocaleTimeString('en-GB');\n      const newEvents = events.map(e=>Object.assign({time}, e));\n      return {\n        clock, uptime, sensors, robots, fire, phase, fireT, phaseT, responder,\n        lastSecs, lastZone, lidarSeed: s.lidarSeed+1,\n        events: newEvents.length ? newEvents.concat(s.events).slice(0,60) : s.events\n      };\n    });\n  }\n\n  ask(title, body, label, fn){\n    this.setState({confirm:{title, body, label}, confirmFn:fn});\n  }\n  closeConfirm(){ this.setState({confirm:null, confirmFn:null}); }\n  runConfirm(){\n    const fn = this.state.confirmFn;\n    this.setState({confirm:null, confirmFn:null});\n    if (fn) fn();\n  }\n\n  approve(){\n    const s = this.state;\n    const b = this.curBld(s);\n    const fz = s.fire ? b.zones.find(z=>z.id===s.fire) : null;\n    this.setState({approved:true});\n    this.addEvent(s.fire, 'dispatch', 'ผู้ควบคุมอนุมัติการเข้าระงับเหตุ · ' + (fz ? fz.name : ''));\n  }\n\n  denyFire(){\n    const s = this.state;\n    this.addEvent(s.fire, 'done', 'ผู้ควบคุมยืนยันว่าไม่ใช่เหตุเพลิงไหม้ · ยกเลิกการส่งหุ่นยนต์');\n    this.reset();\n  }\n\n  trigger(){\n    const s = this.state;\n    if (s.fire){ this.reset(); return; }\n    const b = this.curBld(s);\n    const z = b.zones.find(x=>x.id===s.simZone) || b.zones[0];\n    if (!z) return;\n    this.setState({fire:z.id, phase:'detect', fireT:0, phaseT:0, responder:null, approved:false});\n    this.addEvent(z.id, 'detect', 'ตรวจพบความร้อน + ควันผิดปกติ · AI confirm');\n  }\n\n  reset(){\n    this.setState(s=>({\n      fire:null, phase:'', fireT:0, phaseT:0, responder:null, approved:false,\n      robots: s.robots.map(r=>Object.assign({}, r, {state: r.state==='charging' ? 'charging' : 'patrol'}))\n    }));\n  }\n\n  addBuilding(){\n    const v = (this.bRef.current && this.bRef.current.value || '').trim();\n    if (!v) return;\n    const id = 'B' + (this.state.buildings.length+1) + Date.now().toString(36).slice(-3);\n    const zid = String.fromCharCode(65 + this.state.buildings.reduce((n,b)=>n+b.zones.length,0));\n    const zone = {id:zid, name:'โซน '+zid, type:'พื้นที่ทั่วไป'};\n    this.setState(s=>({\n      buildings: s.buildings.concat([{id, name:v, zones:[zone]}]),\n      sensors: Object.assign({}, s.sensors, {[zid]: this.baseline()}),\n      bld:id, addBld:false, saved:false, simZone:zid\n    }));\n    if (this.bRef.current) this.bRef.current.value = '';\n  }\n\n  addZone(){\n    const name = (this.zRef.current && this.zRef.current.value || '').trim();\n    const type = (this.tRef.current && this.tRef.current.value || '').trim() || 'พื้นที่ทั่วไป';\n    if (!name) return;\n    const id = 'Z' + Date.now().toString(36).slice(-4).toUpperCase();\n    this.setState(s=>({\n      buildings: s.buildings.map(b=> b.id===s.bld ? Object.assign({}, b, {zones:b.zones.concat([{id, name, type}])}) : b),\n      sensors: Object.assign({}, s.sensors, {[id]: this.baseline()}),\n      saved:false\n    }));\n    if (this.zRef.current) this.zRef.current.value = '';\n    if (this.tRef.current) this.tRef.current.value = '';\n  }\n\n  toggleAssign(rid, zid){\n    this.setState(s=>{\n      const cur = (s.assign[rid]||[]).slice();\n      const i = cur.indexOf(zid);\n      if (i >= 0) cur.splice(i,1); else cur.push(zid);\n      return {assign: Object.assign({}, s.assign, {[rid]:cur}), saved:false};\n    });\n  }\n\n  nav(page, opts){\n    const o = opts || {};\n    if (page === this.state.page && !o.force && !this.state.loading) return;\n    const msg = o.msg || {live:'กำลังเชื่อมต่อเซ็นเซอร์ทุกโซน', robots:'กำลังเชื่อมต่อกล้องและ LiDAR', log:'กำลังดึงประวัติเหตุการณ์', ctrl:'กำลังโหลดค่ากำหนดหุ่นยนต์', drill:'กำลังเตรียมสภาพแวดล้อมซ้อม', maps:'กำลังโหลดคลังแผนผัง'}[page];\n    clearTimeout(this.loadT);\n    clearInterval(this.loadI);\n    const t0 = Date.now(), dur = 520;\n    this.setState({loading:true, loadMsg:msg, loadPct:6, page, editMap: page === 'maps' ? this.state.editMap : false});\n    this.loadI = setInterval(()=>{\n      const pct = Math.min(100, (Date.now()-t0)/dur*100);\n      this.setState({loadPct:pct});\n    }, 80);\n    this.loadT = setTimeout(()=>{\n      clearInterval(this.loadI);\n      this.setState({loading:false, loadPct:100});\n    }, dur);\n  }\n\n  autoSave(){\n    clearTimeout(this.saveT);\n    this.saveT = setTimeout(()=>this.save(), 600);\n  }\n\n  componentDidUpdate(){\n    const s = this.state;\n    const sig = JSON.stringify([\n      s.buildings, s.assign, s.thr, s.mode, s.siteName,\n      s.robots.map(r=>[r.id, r.name, r.short, r.color, r.agent, r.serial, r.rosId, r.ip]),\n      s.batLow, s.batFull\n    ]);\n    if (this._sig == null){ this._sig = sig; return; }\n    if (sig !== this._sig){ this._sig = sig; this.autoSave(); }\n  }\n\n  save(){\n    const s = this.state;\n    try {\n      localStorage.setItem('pancabo.config', JSON.stringify({\n        buildings:s.buildings,\n        robots:s.robots.map(r=>({id:r.id, name:r.name, short:r.short, color:r.color, agent:r.agent,\n          serial:r.serial||null, rosId:r.rosId||null, ip:r.ip||null})),\n        assign:s.assign, thr:s.thr, mode:s.mode, siteName:s.siteName,\n        batLow:s.batLow, batFull:s.batFull\n      }));\n      this.setState({saved:true, saveFail:false});\n    } catch(e){\n      this.setState({saved:true, saveFail:true});\n    }\n    setTimeout(()=>this.setState({saved:false, saveFail:false}), 2600);\n  }\n\n  loadSaved(){\n    let raw = null;\n    try { raw = localStorage.getItem('pancabo.config'); } catch(e){}\n    if (!raw) return;\n    let c; try { c = JSON.parse(raw); } catch(e){ return; }\n    if (!c || !c.buildings || !c.buildings.length) return;\n    this.setState(s=>{\n      const sensors = Object.assign({}, s.sensors);\n      c.buildings.forEach(b=>b.zones.forEach(z=>{ if (!sensors[z.id]) sensors[z.id] = this.baseline(); }));\n      const robots = (c.robots||[]).map((r,i)=>Object.assign({x:20+i*25, y:24, tx:20+i*25, ty:24, state:'patrol', bat:90}, r));\n      const seenN = {}, seenS = {};\n      robots.forEach((r,i)=>{\n        if (seenN[r.name]){ r.name = r.name + ' #' + (i+1); }\n        if (seenS[r.short]){ r.short = 'R' + (i+1); }\n        seenN[r.name] = 1; seenS[r.short] = 1;\n      });\n      const b0 = c.buildings[0];\n      return {\n        buildings:c.buildings, sensors, bld:b0.id, simZone: b0.zones[0] ? b0.zones[0].id : null,\n        robots: robots.length ? robots : s.robots, assign: c.assign || s.assign,\n        thr: c.thr, mode: c.mode || s.mode, siteName: c.siteName || s.siteName,\n        batLow: c.batLow, batFull: c.batFull,\n        selRobot: (robots[0]||s.robots[0]).id\n      };\n    });\n  }\n\n  patchRobot(rid, patch){\n    this.setState(s=>({robots:s.robots.map(r=> r.id===rid ? Object.assign({}, r, patch) : r), saved:false}));\n  }\n\n  openPair(){\n    clearTimeout(this.pairT1); clearTimeout(this.pairT2);\n    this.setState({pair:true, pairStep:0, pairFound:null});\n  }\n  closePair(){\n    clearTimeout(this.pairT1); clearTimeout(this.pairT2);\n    this.setState({pair:false, pairStep:0, pairFound:null});\n  }\n  nextUnit(robots){\n    let n = 1;\n    robots.forEach(r=>{\n      const m = /(\\d+)\\s*$/.exec(r.name || '');\n      if (m) n = Math.max(n, +m[1] + 1);\n      const k = /^R(\\d+)$/.exec(r.short || '');\n      if (k) n = Math.max(n, +k[1] + 1);\n    });\n    const taken = id => robots.some(r=> r.name === 'Guardian-'+String(n).padStart(2,'0') || r.short === 'R'+n);\n    while (taken()) n++;\n    return n;\n  }\n\n  freeColor(robots){\n    const palette = ['#2563eb','#0ea5e9','#1e3a8a','#7c3aed','#0f766e','#b45309','#be123c','#4d7c0f'];\n    return palette.find(c=> !robots.some(r=>r.color === c)) || palette[robots.length % palette.length];\n  }\n\n  startScan(){\n    this.setState({pairStep:2, camDenied:false});\n    const n = this.nextUnit(this.state.robots);\n    const used = this.state.robots.map(r=>r.ip).filter(Boolean);\n    let last = 14 + n;\n    while (used.indexOf('192.168.4.'+last) >= 0) last++;\n    const id = 'TESA_BOT_' + String(n).padStart(2, '0');\n    const ip = '192.168.4.' + last;\n    this.pairT1 = setTimeout(()=>{\n      this.setState({pairStep:3, pairFound:{\n        id, ip, port:9090, model:'Guardian FR-2', fw:'2.4.1',\n        serial:'PCB-' + (2400 + Math.floor(Math.random()*90)) + '-' + String.fromCharCode(65+Math.floor(Math.random()*26)) + Math.floor(Math.random()*90+10),\n        name:'Guardian-'+String(n).padStart(2,'0'), short:'R'+n, agent:'Water'}});\n    }, 1700);\n  }\n  confirmPair(){\n    const f = this.state.pairFound;\n    if (!f) return;\n    this.setState({pairStep:4});\n    this.pairT2 = setTimeout(()=>{\n      this.addRobot(f);\n      this.setState({pair:false, pairStep:0, pairFound:null, controlling:f.id, controlIp:f.ip});\n    }, 1300);\n  }\n\n  addRobot(spec){\n    this.setState(s=>{\n      const sp = spec || {};\n      const n = this.nextUnit(s.robots);\n      const id = 'R'+n+Date.now().toString(36).slice(-3);\n      let name = sp.name || 'Guardian-'+String(n).padStart(2,'0');\n      let short = sp.short || 'R'+n;\n      let k = n;\n      while (s.robots.some(r=>r.name === name || r.short === short)){\n        k++; name = 'Guardian-'+String(k).padStart(2,'0'); short = 'R'+k;\n      }\n      const r = {id, name, short,\n        color:this.freeColor(s.robots), agent:sp.agent || 'Water', serial:sp.serial || null,\n        rosId:sp.id || null, ip:sp.ip || null,\n        x:50, y:50, tx:50, ty:50, state:'patrol', bat:100};\n      return {robots:s.robots.concat([r]), assign:Object.assign({}, s.assign, {[id]:[]}), saved:false};\n    });\n  }\n\n  deleteRobot(rid){\n    this.setState(s=>{\n      if (s.robots.length <= 1) return {};\n      const robots = s.robots.filter(r=>r.id!==rid);\n      const assign = Object.assign({}, s.assign); delete assign[rid];\n      return {robots, assign, saved:false,\n        selRobot: s.selRobot===rid ? robots[0].id : s.selRobot,\n        responder: s.responder===rid ? null : s.responder};\n    });\n  }\n\n  spark(hist){\n    const min = Math.min.apply(null, hist), max = Math.max.apply(null, hist);\n    const r = Math.max(1.2, max-min);\n    return hist.map((v,i)=> (i/(hist.length-1)*58).toFixed(1)+','+(35 - ((v-min)/r)*30).toFixed(1)).join(' ');\n  }\n\n  navStyle(active){\n    return {display:'flex', alignItems:'center', gap:'11px', width:'100%', padding:'10px 12px', borderRadius:'10px',\n      border:'none', cursor:'pointer', textAlign:'left', fontFamily:\"'Prompt',sans-serif\", fontSize:'13.5px',\n      fontWeight: active ? 600 : 400, transition:'.15s',\n      background: active ? '#dbeafe' : 'transparent',\n      color: active ? '#1d4ed8' : '#59636f'};\n  }\n  segStyle(active){\n    return {flex:'1', minWidth:'56px', padding:'11px 8px', borderRadius:'10px', cursor:'pointer',\n      fontFamily:\"'Prompt',sans-serif\", fontSize:'13.5px', fontWeight:600, transition:'.15s',\n      border:'1px solid '+(active?'#2563eb':'#e2e8f2'), background: active?'#2563eb':'#fff', color: active?'#fff':'#48566a',\n      boxShadow: active ? '0 4px 12px rgba(37,99,235,.26)' : 'none'};\n  }\n  pillStyle(status){\n    const m = {ok:['#059669','#e7f8f0','rgba(16,185,129,.3)'], watch:['#b45309','#fef4e2','rgba(245,158,11,.3)'], fire:['#dc2626','#fdeaea','rgba(239,68,68,.35)']};\n    const c = m[status] || m.ok;\n    return {fontFamily:\"'Prompt',sans-serif\", fontSize:'10px', letterSpacing:'.2px',\n      fontWeight:600, padding:'3px 9px', borderRadius:'6px', color:c[0], background:c[1], border:'1px solid '+c[2], whiteSpace:'nowrap'};\n  }\n\n  renderVals(){\n    const s = this.state;\n    const threshold = s.thr != null ? s.thr : (this.props.fusionThreshold != null ? this.props.fusionThreshold : 2);\n    const showTrends = this.props.showTrends !== false;\n    const b = this.curBld(s);\n    const g = this.geo(b.zones);\n    const burning = !!s.fire && ['detect','dispatch','spray'].indexOf(s.phase) >= 0;\n    const fz = s.fire ? b.zones.find(z=>z.id===s.fire) : null;\n    const fireAgent = fz ? this.agentFor(fz.type) : '— รอเหตุ —';\n\n    const stat = id => {\n      const d = s.sensors[id] || this.baseline();\n      if (s.fire === id && burning) return 'fire';\n      if (d.temp > 40 || d.smoke > 420) return 'watch';\n      return 'ok';\n    };\n    const statusLabel = {ok:'ปกติ', watch:'เฝ้าระวัง', fire:'ไฟไหม้'};\n\n    const zoneCards = b.zones.map(z=>{\n      const d = s.sensors[z.id] || this.baseline();\n      const st = stat(z.id);\n      const isFire = st === 'fire';\n      const metric = hot => ({textAlign:'center', background:'#fff', border:'1px solid '+(isFire?'rgba(239,68,68,.22)':'#e6ebf2'), borderRadius:'9px', padding:'7px 3px'});\n      const val = hot => ({fontSize:'17px', fontWeight:600, lineHeight:1, fontVariantNumeric:'tabular-nums', color: hot ? '#dc2626' : '#0e1726'});\n      return {\n        name:z.name, type:z.type, status:statusLabel[st],\n        card:{background: isFire?'#fdeaea':'#f6f8fb', border:'1px solid '+(isFire?'#ef4444':'#e6ebf2'), borderRadius:'13px', padding:'12px 14px', transition:'.3s', boxShadow: isFire?'0 6px 18px rgba(239,68,68,.16)':'none'},\n        dot:{width:'8px', height:'8px', borderRadius:'50%', flex:'none', background: isFire?'#ef4444':st==='watch'?'#f59e0b':'#10b981', boxShadow:'0 0 0 3px '+(isFire?'rgba(239,68,68,.18)':st==='watch'?'rgba(245,158,11,.18)':'rgba(16,185,129,.15)')},\n        pill:Object.assign({marginLeft:'auto'}, this.pillStyle(st)),\n        temp:d.temp.toFixed(1), smoke:Math.round(d.smoke), co:Math.round(d.co),\n        mTemp:metric(), mSmoke:metric(), mCo:metric(),\n        vTemp:val(d.temp>45), vSmoke:val(d.smoke>420), vCo:val(d.co>120),\n        spark: showTrends && s.page === 'live' ? this.spark(d.hist) : '',\n        sparkColor: isFire ? '#ef4444' : st==='watch' ? '#f59e0b' : '#2563eb'\n      };\n    });\n\n    const mapZones = b.zones.map(z=>{\n      const d = s.sensors[z.id] || this.baseline();\n      const st = stat(z.id), isFire = st === 'fire';\n      const box = g[z.id];\n      const owner = s.robots.find(r=>(s.assign[r.id]||[]).indexOf(z.id) >= 0);\n      const edit = s.editMap && ((s.estep||2) === 2 || (s.estep||2) === 3), drag = s.dragging === z.id;\n      return {\n        name:z.name, type:z.type, status:statusLabel[st], tempTxt:d.temp.toFixed(1)+'°C',\n        assigned: owner ? owner.short : '—',\n        onDragStart: edit ? (e=>this.startDrag(z.id,'move',e)) : undefined,\n        onResizeStart: edit ? (e=>this.startDrag(z.id,'size',e)) : undefined,\n        onDelete: e=>{\n          if (e){ e.stopPropagation(); e.preventDefault(); }\n          this.ask('ลบโซนนี้?', 'โซน \"'+z.name+'\" และค่าเซ็นเซอร์ทั้งหมดจะถูกลบออกจากผัง', 'ลบโซน', ()=>this.deleteZone(z.id));\n        },\n        onDelDown: e=>{ e.stopPropagation(); },\n        delStyle:{position:'absolute', top:'6px', right:'6px', width:'24px', height:'24px', borderRadius:'8px',\n          display: edit ? 'flex' : 'none', alignItems:'center', justifyContent:'center', cursor:'pointer', zIndex:9,\n          border:'1px solid #fecaca', background:'#fff', color:'#dc2626', fontSize:'12px', lineHeight:1, padding:0,\n          fontFamily:\"'Prompt',sans-serif\", boxShadow:'0 2px 8px rgba(14,23,38,.14)'},\n        handleStyle:{position:'absolute', right:'4px', bottom:'4px', width:'15px', height:'15px', borderRadius:'4px',\n          display: edit ? 'block' : 'none', cursor:'nwse-resize', zIndex:9,\n          background:'#2563eb', border:'2px solid #fff', boxShadow:'0 2px 6px rgba(37,99,235,.4)'},\n        box:{position:'absolute', left:box.l+'%', top:box.t+'%', width:box.w+'%', height:box.h+'%',\n          display:'flex', flexDirection:'column', padding: edit ? '11px 36px 11px 13px' : '11px 13px', borderRadius:'11px',\n          transition: edit ? 'none' : '.4s', cursor: edit ? 'grab' : 'default', userSelect: edit ? 'none' : 'auto',\n          background: isFire ? 'rgba(253,234,234,.88)' : 'rgba(255,255,255,.6)',\n          border:'1.5px solid '+(isFire?'#ef4444':edit?'#93c5fd':'#e4eaf2'),\n          boxShadow: drag ? '0 12px 28px rgba(14,23,38,.18)' : isFire ? 'none' : '0 1px 4px rgba(14,23,38,.05)',\n          zIndex: drag ? 8 : edit ? 6 : 2,\n          pointerEvents: s.editMap && (s.estep||2) !== 2 && (s.estep||2) !== 3 ? 'none' : 'auto',\n          animation: isFire && !edit ? 'pcFire 1.3s infinite' : 'none'},\n        nameStyle:{fontSize:'15px', fontWeight:600, letterSpacing:'-.2px', color: isFire ? '#dc2626' : '#0e1726'},\n        pill:Object.assign({}, this.pillStyle(st), {display: st === 'ok' ? 'none' : 'inline-block'}),\n        tempStyle:{fontFamily:\"'IBM Plex Mono',monospace\", fontSize:'13px', fontWeight:600,\n          color: isFire ? '#dc2626' : st === 'watch' ? '#b45309' : '#48566a'},\n        ownerChip:{display: owner ? 'inline-flex' : 'none', alignItems:'center', justifyContent:'center',\n          minWidth:'22px', height:'19px', padding:'0 6px', borderRadius:'6px', fontFamily:\"'IBM Plex Mono',monospace\",\n          fontSize:'10px', fontWeight:700, color:'#fff', background: owner ? owner.color : '#cbd5e1'},\n        rdot:{width:'8px', height:'8px', borderRadius:'50%', flex:'none', background: owner ? owner.color : '#cbd5e1'}\n      };\n    });\n\n    const stateLabel = {patrol:'ลาดตระเวน', moving:'กำลังเข้าพื้นที่', spraying:'กำลังฉีด', returning:'กำลังกลับ', charging:'ชาร์จไฟ'};\n    const statePill = st => {\n      const m = {patrol:['#2563eb','#e8f1fe','rgba(37,99,235,.25)'], moving:['#0369a1','#e6f5fd','rgba(14,165,233,.3)'],\n        returning:['#0369a1','#e6f5fd','rgba(14,165,233,.3)'], charging:['#059669','#e7f8f0','rgba(16,185,129,.35)'],\n        spraying:['#b45309','#fef4e2','rgba(245,158,11,.3)']};\n      const c = m[st] || m.patrol;\n      return {fontFamily:\"'Prompt',sans-serif\", fontSize:'10px', padding:'3px 9px', borderRadius:'6px',\n        letterSpacing:'.2px', fontWeight:600, color:c[0], background:c[1], border:'1px solid '+c[2], whiteSpace:'nowrap'};\n    };\n\n    const mapRobots = s.robots.map(r=>({\n      short:r.short, state:stateLabel[r.state],\n      wrap:{position:'absolute', left:r.x+'%', top:r.y+'%', width:'30px', height:'30px', zIndex:5,\n        transform:'translate(-50%,-50%)', transition:'left 1.1s cubic-bezier(.4,0,.2,1), top 1.1s cubic-bezier(.4,0,.2,1)'},\n      body:{width:'30px', height:'30px', borderRadius:'10px', position:'relative', zIndex:2, display:'flex',\n        alignItems:'center', justifyContent:'center', fontSize:'11px', fontWeight:700, color:'#fff',\n        background:r.color, boxShadow:'0 4px 14px '+r.color+'80'},\n      scan:{position:'absolute', inset:'-11px', borderRadius:'50%', zIndex:1, border:'2px solid '+r.color+'70',\n        borderRightColor:'transparent', borderBottomColor:'transparent', animation:'pcSpin 1.6s linear infinite'},\n      lbl:Object.assign(r.y > 62 ? {bottom:'34px'} : {top:'34px'},\n        {position:'absolute', left:'50%', transform:'translateX(-50%)', fontFamily:\"'IBM Plex Mono',monospace\",\n        fontSize:'9px', whiteSpace:'nowrap', background:'#fff', padding:'2px 7px', borderRadius:'5px',\n        border:'1px solid #e4eaf2', color:r.color, fontWeight:600, boxShadow:'0 2px 6px rgba(14,23,38,.08)'})\n    }));\n\n    const zoneName = id => { for (const bb of s.buildings){ const z = bb.zones.find(x=>x.id===id); if (z) return z.name; } return id; };\n\n    const fleet = s.robots.map(r=>{\n      const zoneIds = (s.assign[r.id]||[]).filter(z=>b.zones.some(x=>x.id===z));\n      const sel = s.selRobot === r.id;\n      return {\n        short:r.short, name:r.name, agent:r.agent, bat:Math.round(r.bat), state:stateLabel[r.state],\n        zoneLabel: zoneIds.length ? zoneIds.map(zoneName).join(', ') : 'ไม่ได้กำหนด',\n        onClick:()=>{\n          if (s.page === 'robots' && s.selRobot === r.id) return;\n          this.setState({selRobot:r.id});\n          this.nav('robots', {force:true, msg:'กำลังเชื่อมต่อ '+r.name});\n        },\n        row:{display:'flex', alignItems:'center', gap:'11px', padding:'11px 12px', border:'1px solid #e6ebf2',\n          borderRadius:'12px', background:'#f6f8fb', cursor:'pointer', transition:'.2s'},\n        pick:{display:'flex', alignItems:'center', gap:'11px', padding:'11px 15px 11px 11px', borderRadius:'12px',\n          cursor:'pointer', flex:'1 1 190px', minWidth:'190px',\n          transition:'.2s', background: sel ? '#fff' : '#f6f8fb',\n          border:'1px solid '+(sel ? r.color : '#e6ebf2'),\n          boxShadow: sel ? '0 4px 14px rgba(14,23,38,.09)' : 'none'},\n        badge:{width:'32px', height:'32px', borderRadius:'9px', flex:'none', display:'flex', alignItems:'center',\n          justifyContent:'center', fontWeight:700, color:'#fff', fontSize:'12px', background:r.color},\n        pill:statePill(r.state),\n        batBar:{display:'block', height:'100%', width:Math.round(r.bat)+'%',\n          background: r.bat < 25 ? '#ef4444' : r.bat < 50 ? '#f59e0b' : '#10b981'}\n      };\n    });\n\n    const fd = s.fire ? (s.sensors[s.fire] || this.baseline()) : null;\n    const ref = fd || (s.sensors[s.simZone] || this.baseline());\n    const vFlame = ref.flame, vSmoke = ref.smoke, vTemp = ref.temp, vAi = burning ? Math.min(.99, ref.flame*1.02) : .04;\n    const trips = [vFlame > .5, vSmoke > 420, vTemp > 45, vAi > .6].filter(Boolean).length;\n    const bar = (pct, trip) => ({display:'block', height:'100%', borderRadius:'5px', width:Math.max(3, Math.min(100,pct))+'%',\n      transition:'width .5s', background: trip ? 'linear-gradient(90deg,#f87171,#dc2626)' : 'linear-gradient(90deg,#38bdf8,#0ea5e9)'});\n    const votes = [\n      {key:'flame IR', val:vFlame.toFixed(2), bar:bar(vFlame*100, vFlame>.5)},\n      {key:'smoke MQ-2', val:Math.round(vSmoke), bar:bar(vSmoke/10, vSmoke>420)},\n      {key:'temp', val:vTemp.toFixed(0)+'°', bar:bar(vTemp, vTemp>45)},\n      {key:'AI vision', val:vAi.toFixed(2), bar:bar(vAi*100, vAi>.6)}\n    ];\n\n    const phaseLabels = {detect: s.mode === 'confirm' && !s.approved ? 'รอผู้ควบคุมอนุมัติ' : 'ตรวจพบ · verifying', dispatch:'กำลังส่งหุ่นยนต์', spray:'กำลังฉีดสารดับ', cooldown:'ตรวจสอบซ้ำ'};\n    const traceStep = (label, done, at) => ({\n      label, at: at || '—',\n      dot:{width:'8px', height:'8px', borderRadius:'50%', flex:'none', background: done ? '#10b981' : '#cbd5e1'},\n      text:{fontSize:'12px', color: done ? '#0e1726' : '#94a3b8', fontWeight: done ? 600 : 400}\n    });\n    const ph = s.phase;\n    const trace = [\n      traceStep('Sensor fusion ผ่านเกณฑ์', !!s.fire, s.fire ? 'T+0s' : ''),\n      traceStep('AI vision ยืนยันเปลวไฟ', ['dispatch','spray','cooldown'].indexOf(ph)>=0 || ph==='detect', s.fire ? 'T+2s' : ''),\n      traceStep('เลือกสารดับ + ส่งหุ่นยนต์', ['dispatch','spray','cooldown'].indexOf(ph)>=0, ph==='dispatch'||ph==='spray'||ph==='cooldown' ? 'T+'+Math.max(2,s.fireT-s.phaseT)+'s' : ''),\n      traceStep('ฉีดสารดับ · ควบคุมเพลิง', ['spray','cooldown'].indexOf(ph)>=0, ph==='cooldown' ? 'T+'+s.lastSecs+'s' : '')\n    ];\n\n    const hot = b.zones.map(z=>({z, d:s.sensors[z.id]||this.baseline()})).sort((a,c)=>c.d.temp-a.d.temp)[0];\n    const ready = s.robots.filter(r=>r.state==='patrol').length;\n\n    const zoneRows = b.zones.map(z=>({\n      id:z.id, name:z.name, type:z.type, agent:this.agentFor(z.type),\n      onName: e=>this.patchZone(z.id, {name:e.target.value}),\n      onType: e=>this.patchZone(z.id, {type:e.target.value}),\n      onDelete: ()=>this.ask('ลบโซนนี้?', 'โซน \"'+z.name+'\" และค่าเซ็นเซอร์ทั้งหมดจะถูกลบออกจากผัง', 'ลบโซน', ()=>this.deleteZone(z.id)),\n      input:{flex:'1', minWidth:'0', padding:'8px 11px', borderRadius:'8px', border:'1px solid #e6ebf2',\n        background:'#fff', fontFamily:\"'Prompt',sans-serif\", fontSize:'13px', color:'#0e1726', outline:'none'},\n      del:{width:'32px', height:'32px', flex:'none', borderRadius:'8px', cursor:'pointer', fontSize:'15px',\n        border:'1px solid #e6ebf2', background:'#fff', color:'#94a3b8', lineHeight:1}\n    }));\n\n    const inputCss = {flex:'1', minWidth:'0', padding:'8px 11px', borderRadius:'8px', border:'1px solid #e6ebf2',\n      background:'#fff', fontFamily:\"'Prompt',sans-serif\", fontSize:'13px', color:'#0e1726', outline:'none'};\n    const agents = ['Water','Foam','CO₂'];\n\n    const robotRows = s.robots.map(r=>({\n      short:r.short, name:r.name,\n      badge:{width:'34px', height:'34px', borderRadius:'9px', flex:'none', display:'flex', alignItems:'center',\n        justifyContent:'center', fontWeight:700, color:'#fff', fontSize:'13px', background:r.color},\n      onName: e=>this.patchRobot(r.id, {name:e.target.value}),\n      input:Object.assign({}, inputCss, {padding:'7px 10px', fontSize:'13.5px', fontWeight:600}),\n      serial: r.rosId ? '● ' + r.rosId + ' · ' + r.ip : (r.serial ? '● ' + r.serial : '○ ยังไม่ได้จับคู่'),\n      serialStyle:{fontFamily: (r.rosId || r.serial) ? \"'IBM Plex Mono',monospace\" : \"'Prompt',sans-serif\",\n        fontSize:'11px', whiteSpace:'nowrap', overflow:'hidden', textOverflow:'ellipsis', paddingLeft:'2px',\n        color: (r.rosId || r.serial) ? '#047857' : '#64748b'},\n      card:{padding:'13px 14px', borderRadius:'13px', background:'#f6f8fb', border:'1px solid #e6ebf2'},\n      fieldLabel:{fontSize:'11.5px', color:'#64748b', flex:'none'},\n      state:stateLabel[r.state], pill:statePill(r.state), bat:Math.round(r.bat),\n      batBar:{display:'block', height:'100%', width:Math.round(r.bat)+'%',\n        background: r.bat < 25 ? '#ef4444' : r.bat < 50 ? '#f59e0b' : '#10b981'},\n      onDelete: ()=>this.ask('ลบหุ่นยนต์นี้?', '\"'+r.name+'\" จะถูกถอดออกจากระบบ และต้องสแกน QR ใหม่หากจะเชื่อมต่ออีกครั้ง'